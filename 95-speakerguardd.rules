SUBSYSTEM=="sound", DRIVERS=="snd-soc-macaudio", GOTO="speakerguardd_macaudio"
GOTO="speakerguardd_end"

LABEL="speakerguardd_macaudio"
KERNEL=="pcmC*D2c", ATTRS{id}=="AppleJ*", ENV{ACP_IGNORE}="1"

KERNEL=="pcmC*D2c", ATTRS{id}=="AppleJ700", TAG+="systemd", ENV{SYSTEMD_WANTS}="speakerguardd.service"
# Machines with V/I sense that speakersafetyd also covers: mask speakersafetyd
# to use this daemon there (the unit conflicts with it; see README.md).  The
# J616 is not qualified (conf/apple/j616.conf) and is not started here.
KERNEL=="pcmC*D2c", ATTRS{id}=="AppleJ316|AppleJ413", TAG+="systemd", ENV{SYSTEMD_WANTS}="speakerguardd.service"

LABEL="speakerguardd_end"
