[Unit]
Description=Speaker Protection Daemon (feed-forward)
# Restarts are safe: until the daemon renews the card's volume lock the
# speakers sit at the card's safe level.  A restarted daemon resumes the
# thermal model from /run/speakerguardd/state only after a clean stop, and
# otherwise starts it at the coils' limit.  A crash loop gives up after five
# attempts and leaves the speakers at that level.
# One daemon owns the speaker sense PCM and the volume interlock.
Conflicts=speakersafetyd.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# Boot-target and PCM udev activation can precede ALSA card discovery.
# Wait inside the daemon before touching the interlock; the kernel keeps
# the speakers at its safe level until the daemon takes the volume lock.
ExecStart=/usr/bin/speakerguardd -c /usr/share/speakerguardd --wait-for-card 30
UMask=0066
RuntimeDirectory=speakerguardd
RuntimeDirectoryPreserve=yes
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
