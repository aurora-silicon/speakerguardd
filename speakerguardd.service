[Unit]
Description=Speaker Protection Daemon (feed-forward)
# Restarts are safe: until the daemon renews the card's volume lock the
# speakers sit at the card's safe level.  A restarted daemon resumes the
# thermal model from /run/speakerguardd/state after a clean stop or the
# durable checkpoint in /var/lib/speakerguardd/state within this boot. With
# no provably current state the V/I models start at the cross-OS hot envelope,
# with full-scale program power bounded by the governor before unlock.
# A crash loop gives up after five tries;
# the card then holds its safe level.
# One daemon owns the speaker sense PCM and the volume interlock: whichever
# takes it first protects the speakers, and the other cannot start.  This
# unit never stops another protection daemon (speakersafetyd on the
# machines with V/I sense) to make room: a machine is switched to this one
# on purpose, by masking speakersafetyd or by a drop-in that adds
# Conflicts=speakersafetyd.service together with
# OnFailure=speakersafetyd.service.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# Boot-target and PCM udev activation can precede ALSA card discovery.
# Wait inside the daemon before touching the interlock; the kernel keeps
# the speakers at its safe level until the daemon takes the volume lock.
ExecStart=/usr/bin/speakerguardd -c /usr/share/speakerguardd --wait-for-card 30
# This unit never prunes recordings. Replace a local destructive ExecStartPre
# with the packaged preservation helper; see docs/recording-retention.md.
UMask=0066
RuntimeDirectory=speakerguardd
RuntimeDirectoryPreserve=yes
Restart=on-failure
RestartSec=1
# A configuration the daemon refuses to govern exits 78 before the card is
# touched; restarting cannot change it.
RestartPreventExitStatus=78

[Install]
WantedBy=multi-user.target
