[Unit]
Description=Speaker protection graph for this user's PipeWire (speakerguardd v2)
Documentation=https://github.com/aurora-silicon/speakerguardd/blob/v2/docs/NEW-PLATFORM.md
# Before PipeWire and WirePlumber read their configuration: for the seat
# user it links the generated graph (/run/speakerguardd-graph) into the
# user's pipewire.conf.d and wireplumber.conf.d; for every other user it
# removes those links. It never fails, so it never holds PipeWire back.
Before=pipewire.service wireplumber.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/speakerguardd/speakerguardd-provision graph-user

[Install]
WantedBy=pipewire.service
