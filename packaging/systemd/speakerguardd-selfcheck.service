[Unit]
Description=Speaker wiring self-check, silent (speakerguardd v2)
Documentation=https://github.com/aurora-silicon/speakerguardd/blob/v2/docs/NEW-PLATFORM.md
# Before the supervisor, while the kernel holds the speakers at its floor:
# it derives this Mac's speaker wiring from the device tree and the tuning,
# proves it with zero-sample streams only, and binds the result to the
# board, the kernel release, the parameter blob and the wiring. A passing
# record for exactly this combination is kept, so a boot without a kernel
# or tuning change only checks the binding. A failure leaves the floor.
Before=speakerguardd.service
After=systemd-udev-settle.service
ConditionPathExists=/proc/device-tree/compatible

[Service]
Type=oneshot
# SGV2_PARAMS: the parameter blob (as in SGV2_ARGS); SGV2_TUNING: the tuning
# source the blob was compiled from, as aurora-speaker-tuning takes it
# (empty: the installer's bundle in the vendor firmware).
EnvironmentFile=/etc/speakerguardd/speakerguardd.conf
ExecStart=/usr/libexec/speakerguardd/speakerguardd-selfcheck run --params ${SGV2_PARAMS} -- $SGV2_TUNING
StateDirectory=speakerguardd
StateDirectoryMode=0755
RuntimeDirectory=speakerguardd-selfcheck
TimeoutStartSec=120

[Install]
RequiredBy=speakerguardd.service
