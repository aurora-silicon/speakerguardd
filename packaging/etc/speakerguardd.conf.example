# /etc/speakerguardd/speakerguardd.conf is generated at every boot by
# speakerguardd-provision (docs/NEW-PLATFORM.md, section 4); this is what it
# looks like on the MacBook Pro J316. Do not edit it: overrides go in
# /etc/speakerguardd/provision.conf (SGV2_SEAT_USER=<name>, SGV2_BUNDLE=<path>).
#
# The machine key, from the device tree's "apple,<key>-macaudio" speaker card
# (the J316s and J316c are both j316), for the session helper.
SGV2_MACHINE=j316
# The seat user, by name, and its uid from the user database.
SGV2_USER=ryan
SGV2_UID=1000
# The supervisor: the speaker card, its speaker PCM (the front-end
# "Secondary"), the seat user's uid and the parameter blob, compiled for this
# board from this Mac's own tuning (the supervisor refuses a blob for another
# Mac).
SGV2_ARGS="--card AppleJ316 --pcm 1 --uid 1000 --params /var/lib/speakerguardd/params.bin"
# The self-check: the same blob, and the tuning source it was compiled from
# (empty: the installer's bundle).
SGV2_PARAMS=/var/lib/speakerguardd/params.bin
SGV2_TUNING=
