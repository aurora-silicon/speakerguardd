policy_module(speakerguardd, 0.1.0)

# TODO(lane D): complete and test in enforcing mode on every machine; the
# gate is zero AVCs (ausearch -m AVC,USER_AVC -ts boot) after the full
# qualification suite, including fault injection.

type speakerguardd_t;
type speakerguardd_exec_t;
init_daemon_domain(speakerguardd_t, speakerguardd_exec_t)
# The unit runs with NoNewPrivileges=yes.
init_nnp_daemon_domain(speakerguardd_t)

type speakerguardd_runtime_t;
files_pid_file(speakerguardd_runtime_t)
manage_dirs_pattern(speakerguardd_t, speakerguardd_runtime_t, speakerguardd_runtime_t)
manage_files_pattern(speakerguardd_t, speakerguardd_runtime_t, speakerguardd_runtime_t)
# The engine page is shared memory.
allow speakerguardd_t speakerguardd_runtime_t:file map;
files_pid_filetrans(speakerguardd_t, speakerguardd_runtime_t, { dir file })

# The tuning bundle in the vendor firmware tree, and the ESP fallback.
files_read_kernel_modules(speakerguardd_t)
dev_read_sysfs(speakerguardd_t)
fs_read_dos_files(speakerguardd_t)

# The macaudio control device: interlock and amp gain.
# (refpolicy has no dev_rw_sound; read includes ioctl)
dev_read_sound(speakerguardd_t)
dev_write_sound(speakerguardd_t)

# PCM ownership from /proc/asound, and the owning thread's Tgid from
# /proc/<tid>/status (PipeWire runs in the user's domain).
kernel_read_system_state(speakerguardd_t)
domain_read_all_domains_state(speakerguardd_t)

# The 10 ms loop: SCHED_FIFO and locked memory.
allow speakerguardd_t self:capability { sys_nice ipc_lock };
allow speakerguardd_t self:process { setsched getsched };
# Hands the engine page and the helper's report directory (setgid root) to
# the session user.
allow speakerguardd_t self:capability { chown fowner };
# The kernel requires CAP_SYS_ADMIN to lock and write "Speaker Protection"
# (aurora-silicon/linux#922, 865ee493).
allow speakerguardd_t self:capability sys_admin;

# Type=notify: READY=1 and WATCHDOG=1 to systemd.
allow speakerguardd_t self:unix_dgram_socket create_socket_perms;
init_write_pid_socket(speakerguardd_t)
init_dgram_send(speakerguardd_t)
# systemd's notify socket is labelled kernel_t on Fedora.
kernel_dgram_send(speakerguardd_t)

# The boot id (/proc/sys/kernel/random/boot_id) binds the persisted thermal
# state to this boot.
kernel_read_kernel_sysctls(speakerguardd_t)

# Its configuration.
files_read_etc_files(speakerguardd_t)

# The first-boot self-check's record and the parameter blob
# (/var/lib/speakerguardd), written by speakerguardd-selfcheck.service and
# speakerguardd-provision.service and read before any grant. Both run as
# ordinary system services (unconfined_service_t on Fedora); systemd creates
# the directory with this label (StateDirectory=), and their files inherit
# it, so the supervisor reads them with the rules below and nothing else. The
# configuration provisioning writes (/etc/speakerguardd) is read by systemd
# (EnvironmentFile=), not by this domain.
type speakerguardd_var_lib_t;
files_type(speakerguardd_var_lib_t)
files_search_var_lib(speakerguardd_t)
list_dirs_pattern(speakerguardd_t, speakerguardd_var_lib_t, speakerguardd_var_lib_t)
read_files_pattern(speakerguardd_t, speakerguardd_var_lib_t, speakerguardd_var_lib_t)
