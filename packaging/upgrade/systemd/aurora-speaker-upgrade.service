[Unit]
Description=Move the speakers to speakerguardd v2 with this Mac's own tuning
Documentation=https://github.com/aurora-silicon/speakerguardd/blob/v2/packaging/upgrade/README.md
# Shipped disabled: users opt in (systemctl enable --now aurora-speaker-upgrade)
# until the rollout is approved. Idempotent: a Mac already on v2 with its
# bundle does nothing. Any failure leaves the legacy protection in charge.
# speakerguardd v2 is a preview: without --i-understand-preview this unit
# exits 2 ("not now") and switches nothing. Opting in through the unit takes
# a drop-in that adds the flag (README.md).
After=local-fs.target sound.target systemd-udev-settle.service network-online.target
Wants=network-online.target
ConditionPathExists=/proc/device-tree/compatible

[Service]
Type=oneshot
ExecStart=/usr/bin/aurora-speaker-upgrade run --at-boot
# 1 = refused (the legacy protection keeps the speakers, the reason is in the
# journal and in refused.json) and 2 = cannot run yet (no card, the speakers
# busy) are outcomes, not failures of the unit. A refusal is not retried at
# boot until the kernel, speakerguardd or the parity attestation changes.
SuccessExitStatus=1 2
TimeoutStartSec=900
StateDirectory=aurora-speaker-upgrade
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
