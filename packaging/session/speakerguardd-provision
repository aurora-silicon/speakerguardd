#!/usr/bin/python3 -I
"""speakerguardd-provision: set up speakerguardd v2 on this Mac, with no
manual step, before the self-check and the supervisor start.

    speakerguardd-provision run      [--bundle SRC] [--force]   (root, speakerguardd-provision.service)
    speakerguardd-provision activate [--graph-unit UNIT]        (root, after the self-check passed)
    speakerguardd-provision seat     --unit UNIT                (root, when seat0 changes hands)
    speakerguardd-provision graph-user                          (the user's speakerguardd-graph.service)
    speakerguardd-provision is-seat                             (ExecCondition of the session helper)
    speakerguardd-provision status

`run`:
1. **Compile** the installer's tuning bundle (the vendor firmware tree, then
   the ESP's vendorfw archive; or `--bundle`, or `SGV2_BUNDLE` in
   /etc/speakerguardd/provision.conf) into /var/lib/speakerguardd/params.bin
   with `aurora-speaker-tuning compile`, for this Mac's device tree.
   The bundle is bound to the Mac it was collected on (aurora-speaker-tuning
   `compile`): a bundle the installer collected on another board or another
   unit (its `unit_id` is not this Mac's device-tree `serial-number`'s) does
   not compile, so provisioning fails closed. A bundle collected before the
   installer recorded the unit compiles without its per-unit calibration
   (open loop at the base limits) and the journal says to collect it again.
   Collecting again: the installer's firmware step on this Mac's macOS, or
   tools/speaker-tuning/collect-macos.sh there and install-linux.sh here
   (aurora-installer), then restart speakerguardd-provision.service.
2. **Bind** the blob to the board, the unit (the unit ID of the device
   tree's `serial-number`, never the serial itself), the kernel release, the
   bundle's digest, the macOS build it was collected from, the device tree's
   speaker ID and the compiler (/var/lib/speakerguardd/provision.bind). The
   next run compiles again only if one of those changed, or the blob is not
   the one bound.
3. **Resolve the seat user by name**, never by a fixed uid: the name in
   provision.conf (`SGV2_SEAT_USER`), else the user of seat0's active
   session, else the last such user, else the display manager's automatic
   login, else the only regular user. Several users and none of those: no
   seat user yet, and the seat watcher provisions at the first login.
4. **Write** /etc/speakerguardd/speakerguardd.conf for the units: the
   machine, the seat user's name and uid, the supervisor's arguments (the
   speaker card, its speaker PCM, the uid, the blob) and the self-check's.

Any failure fails closed: the blob and the configuration are removed (so
neither an older blob nor an older seat user can be used), the self-check
and the supervisor do not start (they require this unit), the kernel holds
the speakers at its floor, and the journal lists every reason.

`activate` (the self-check's ExecStartPost) generates the machine's
PipeWire and WirePlumber files from the self-check's record into
/run/speakerguardd-graph, and refreshes the seat user's session if its
PipeWire started before they changed. The user's speakerguardd-graph.service,
ordered before PipeWire, links them into that user's configuration only for
the seat user (and removes them for everyone else). The links point into
/run, so after a reboot without v2 they lead nowhere and PipeWire skips
them.

`seat` (speakerguardd-seat.path, on every seat0 change) restarts the
supervisor, which provisions again, when seat0's regular user is not the one
provisioned.

`--root DIR` (or SGV2_PROVISION_ROOT) moves every file this program writes
or reads under DIR, for tests: etc/speakerguardd, var/lib/speakerguardd,
run/speakerguardd-graph. The device tree, the users and the kernel stay the
live ones.
"""
import argparse
import configparser
import glob
import hashlib
import json
import os
import pwd
import re
import shutil
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)

VERSION = 1
DT = "/proc/device-tree"
GENERATED = "# Generated by speakerguardd-provision"
# A token the units' EnvironmentFile and $VAR splitting carry unchanged.
SAFE = re.compile(r"^[A-Za-z0-9_./:@+-]*$")


def log(*a):
    print("speakerguardd-provision:", *a, file=sys.stderr, flush=True)


class Failed(Exception):
    pass


class Paths:
    def __init__(self, root=""):
        self.root = root or ""
        r = lambda p: os.path.join(self.root, p.lstrip("/")) if self.root else p  # noqa: E731
        self.etc = r("/etc/speakerguardd")
        self.conf = os.path.join(self.etc, "speakerguardd.conf")
        self.override = os.path.join(self.etc, "provision.conf")
        self.state = r("/var/lib/speakerguardd")
        self.params = os.path.join(self.state, "params.bin")
        self.bind = os.path.join(self.state, "provision.bind")
        self.report = os.path.join(self.state, "provision.json")
        self.seat_last = os.path.join(self.state, "seat-user")
        self.selfcheck_json = os.path.join(self.state, "selfcheck.json")
        self.graph = r("/run/speakerguardd-graph")
        self.graph_state = os.path.join(self.graph, "state")


# ------------------------------------------------------------------ files


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for b in iter(lambda: f.read(1 << 16), b""):
            h.update(b)
    return h.hexdigest()


def write_atomic(path, text, mode=0o644):
    tmp = f"{path}.new{os.getpid()}"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_CLOEXEC | os.O_NOFOLLOW, mode)
    try:
        os.fchmod(fd, mode)
        os.write(fd, text.encode())
        os.fsync(fd)
    finally:
        os.close(fd)
    os.rename(tmp, path)


def read_kv(path):
    """A shell-style KEY=value file (the units' EnvironmentFile form)."""
    out = {}
    try:
        with open(path) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                v = v.strip()
                if len(v) >= 2 and v[0] == v[-1] and v[0] in "\"'":
                    v = v[1:-1]
                out[k.strip()] = v
    except OSError:
        pass
    return out


def unlink(path):
    try:
        os.unlink(path)
    except FileNotFoundError:
        pass


def ensure_dir(path, mode, live):
    """A directory this program writes in. In production systemd creates
    it (StateDirectory=, RuntimeDirectory=) with its SELinux label; one made
    here is relabelled, so the supervisor's domain can read what is in it."""
    if os.path.isdir(path):
        return
    os.makedirs(path, mode=mode, exist_ok=True)
    if live and shutil.which("restorecon"):
        subprocess.run(["restorecon", "-R", path], capture_output=True)


# ------------------------------------------------------------------ machine


def board_of(dt=DT):
    try:
        with open(os.path.join(dt, "compatible"), "rb") as f:
            first = f.read().split(b"\0", 1)[0].decode()
    except (OSError, UnicodeDecodeError) as e:
        raise Failed(f"no Apple device tree ({e})")
    if not first.startswith("apple,") or len(first) <= 6:
        raise Failed(f"the device tree's first compatible is {first!r}, not apple,<board>")
    return first[6:]


# aurora-speaker-tuning's machine::unit_id: the same domain tag and rule.
UNIT_ID_DOMAIN = b"aurora-speaker-unit-v1\0"


def unit_id(dt=DT):
    """The unit ID of the device tree's root serial-number (or "-"): what
    the compiler binds the bundle to. Never the serial itself."""
    try:
        with open(os.path.join(dt, "serial-number"), "rb") as f:
            serial = f.read().rstrip(b"\0")
    except OSError:
        return "-"
    if not 0 < len(serial) <= 64 or not all(0x21 <= b <= 0x7E for b in serial):
        return "malformed"
    return hashlib.sha256(UNIT_ID_DOMAIN + serial).hexdigest()


def speaker_id_raw(dt=DT):
    """The loader's speaker ID property, as hex (or "-"): the compiler reads it."""
    try:
        with open(os.path.join(dt, "chosen", "asahi,speaker-id"), "rb") as f:
            return f.read().hex() or "-"
    except OSError:
        return "-"


def machine_of(dt):
    """(machine key, the card id macaudio gives it), from this Mac's device
    tree (wiring.machine_key, wiring.card_id)."""
    import wiring

    try:
        hw = wiring.read_dt(dt)
        return wiring.machine_key(hw), wiring.card_id(hw)
    except (wiring.Refused, OSError) as e:
        raise Failed(f"the device tree: {e}")


def find_card(want, wait, sysfs="/sys/class/sound"):
    """(index, id) of the speaker card: the macaudio card, by its device
    tree node. Its id must be `want`, the one macaudio derives from the
    device tree's model."""
    deadline = time.monotonic() + wait
    while True:
        for d in sorted(os.listdir(sysfs)) if os.path.isdir(sysfs) else []:
            if not re.fullmatch(r"card\d+", d):
                continue
            try:
                with open(f"{sysfs}/{d}/device/of_node/compatible", "rb") as f:
                    if b"apple,macaudio" not in f.read().split(b"\0"):
                        continue
                with open(f"/proc/asound/{d}/id") as f:
                    cid = f.read().strip()
            except OSError:
                continue
            if want and want != cid:
                raise Failed(f"the speaker card is {cid}, but the device tree's model names {want}")
            return int(d[4:]), cid
        if time.monotonic() >= deadline:
            raise Failed(f"no speaker card (apple,macaudio) after {wait:.0f} s: is the kernel's macaudio driver loaded?")
        time.sleep(0.25)


def speaker_pcm(idx):
    """The speaker front-end's playback PCM device (id "Secondary")."""
    for d in sorted(os.listdir(f"/proc/asound/card{idx}")):
        m = re.fullmatch(r"pcm(\d+)p", d)
        if not m:
            continue
        try:
            with open(f"/proc/asound/card{idx}/{d}/info") as f:
                info = dict(l.split(": ", 1) for l in f.read().splitlines() if ": " in l)
        except OSError:
            continue
        if re.sub(r"\s*\(\*\)$", "", info.get("id", "").strip()) == "Secondary":
            return int(m.group(1))
    raise Failed(f"card {idx} has no speaker playback PCM (id Secondary)")


# ------------------------------------------------------------------ seat user


def uid_range(login_defs="/etc/login.defs"):
    lo, hi = 1000, 60000
    try:
        with open(login_defs) as f:
            for line in f:
                p = line.split()
                if len(p) >= 2 and p[0] in ("UID_MIN", "UID_MAX") and p[1].isdigit():
                    if p[0] == "UID_MIN":
                        lo = int(p[1])
                    else:
                        hi = int(p[1])
    except OSError:
        pass
    return lo, hi


NOLOGIN = ("nologin", "false")


def regular(pw, rng):
    return rng[0] <= pw.pw_uid <= rng[1] and os.path.basename(pw.pw_shell or "") not in NOLOGIN


def by_name(name):
    try:
        return pwd.getpwnam(name)
    except (KeyError, TypeError):
        return None


def seat0_user(rng):
    """The regular user of seat0's active session, or None (no session, a
    greeter, no logind)."""
    try:
        sid = subprocess.run(["loginctl", "show-seat", "seat0", "--property=ActiveSession", "--value"],
                             capture_output=True, text=True, timeout=10).stdout.strip()
        if not sid:
            return None
        out = subprocess.run(["loginctl", "show-session", sid, "--property=Name", "--property=Class"],
                             capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.TimeoutExpired):
        return None
    props = dict(l.split("=", 1) for l in out.splitlines() if "=" in l)
    pw = by_name(props.get("Name", ""))
    if props.get("Class") != "user" or pw is None or not regular(pw, rng):
        return None
    return pw.pw_name


def autologin_user(etc="/etc"):
    """The display manager's automatic login user, if one is configured."""
    def ini(paths):
        c = configparser.ConfigParser(strict=False, interpolation=None)
        c.optionxform = str
        try:
            c.read(paths)
        except configparser.Error:
            return None
        return c

    c = ini([f"{etc}/gdm/custom.conf"])
    if c and c.has_section("daemon"):
        en = c.get("daemon", "AutomaticLoginEnable", fallback="").strip().lower()
        if en in ("true", "1", "yes") and c.get("daemon", "AutomaticLogin", fallback="").strip():
            return c.get("daemon", "AutomaticLogin").strip()
    c = ini([f"{etc}/sddm.conf", *sorted(glob.glob(f"{etc}/sddm.conf.d/*.conf"))])
    if c and c.get("Autologin", "User", fallback="").strip():
        return c.get("Autologin", "User").strip()
    c = ini([f"{etc}/lightdm/lightdm.conf", *sorted(glob.glob(f"{etc}/lightdm/lightdm.conf.d/*.conf"))])
    if c:
        for s in c.sections():
            if s.startswith("Seat:") and c.get(s, "autologin-user", fallback="").strip():
                return c.get(s, "autologin-user").strip()
    return None


def regular_users(rng):
    return sorted({pw.pw_name for pw in pwd.getpwall() if regular(pw, rng)})


def resolve_seat_user(p, override, rng=None, etc="/etc"):
    """(name, how). Raises Failed when there is no seat user to name."""
    rng = rng or uid_range(os.path.join(etc, "login.defs"))
    if override.get("SGV2_SEAT_USER"):
        name = override["SGV2_SEAT_USER"]
        pw = by_name(name)
        if pw is None or pw.pw_uid == 0:
            raise Failed(f"{p.override} names SGV2_SEAT_USER={name}, which is not a user (or is root)")
        return name, "provision.conf"
    name = seat0_user(rng)
    if name:
        return name, "seat0"
    try:
        with open(p.seat_last) as f:
            last = f.read().strip()
        pw = by_name(last)
        if pw is not None and regular(pw, rng):
            return last, "last seat0 user"
    except OSError:
        pass
    name = autologin_user(etc)
    if name:
        pw = by_name(name)
        if pw is not None and pw.pw_uid != 0:
            return name, "automatic login"
    users = regular_users(rng)
    if len(users) == 1:
        return users[0], "only regular user"
    raise Failed(
        f"no seat user: {len(users)} regular users ({', '.join(users) or 'none'}) and nobody has logged in on seat0 "
        f"yet; the first login there provisions speakerguardd (or set SGV2_SEAT_USER=<name> in {p.override})"
    )


# ------------------------------------------------------------------ tuning


def tuning_cli(args):
    cli = shutil.which(args.tuning_cli)
    if not cli:
        raise Failed(f"{args.tuning_cli}: not found")
    return os.path.realpath(cli)


def identify(cli, source):
    r = subprocess.run([cli, "identify", "--json", *source], capture_output=True, text=True, timeout=120)
    try:
        v = json.loads(r.stdout)
    except ValueError:
        raise Failed(f"{os.path.basename(cli)} identify gave no JSON (exit {r.returncode}): {r.stderr.strip()[-300:]}")
    if r.returncode != 0 or "error" in v:
        raise Failed(f"no usable speaker tuning bundle: {v.get('error', r.stderr.strip()[-300:])}")
    if not v.get("verified"):
        raise Failed(f"the tuning at {v.get('source')} is not a verified installer bundle")
    return v


def compile_blob(cli, source, out):
    """The compiler's summary line and its warnings (an unbound bundle's
    open loop among them), for the journal."""
    r = subprocess.run([cli, "compile", *source, "-o", out], capture_output=True, text=True, timeout=300)
    if r.returncode != 0:
        lines = [l for l in r.stderr.splitlines() if l.startswith(("error", "fatal"))] or r.stderr.splitlines()[-5:]
        raise Failed("the tuning bundle does not compile for this Mac:\n" + "\n".join(lines))
    lines = r.stderr.strip().splitlines()
    return "\n".join(lines[:1] + [l for l in lines[1:] if l.startswith("warning")])


# ------------------------------------------------------------------ run

BIND_KEYS = ["version", "board", "unit", "kernel", "bundle_digest", "macos_build", "speaker_id", "compiler", "source", "params_sha256"]


def source_args(args, override):
    src = args.bundle or override.get("SGV2_BUNDLE", "")
    if src and not SAFE.match(src):
        raise Failed(f"the bundle path {src!r} has characters the units' configuration cannot carry")
    if src and not os.path.exists(src):
        raise Failed(f"the bundle {src} does not exist")
    return src, (["--bundle", src] if src else [])


def conf_text(rec, entry_key, user, uid, card, pcm, p, src):
    for v in (entry_key, user, card, p.params):
        if not SAFE.match(str(v)):
            raise Failed(f"{v!r} cannot be carried in {p.conf}")
    sargs = f"--card {card} --pcm {pcm} --uid {uid} --params {p.params}"
    return "\n".join([
        f"{GENERATED} on {rec['time']}; it is rewritten on every boot.",
        f"# Overrides go in {p.override} (SGV2_SEAT_USER=<name>, SGV2_BUNDLE=<path>).",
        f"# Board {rec['board']}, kernel {rec['kernel']}, tuning {rec['aid']} from macOS {rec['macos_build']},",
        f"# blob {rec['params_sha256'][:16]}; seat user {user} ({rec['seat_how']}).",
        f"SGV2_MACHINE={entry_key}",
        f"SGV2_USER={user}",
        f"SGV2_UID={uid}",
        f'SGV2_ARGS="{sargs}"',
        f"SGV2_PARAMS={p.params}",
        f"SGV2_TUNING={src}",
        "",
    ])


def fail_closed(p, rec, reasons):
    """Nothing older may be used: no blob, no configuration (a hand-written
    one is kept aside, as on success), no graph."""
    for f in (p.params, p.conf):
        try:
            if f == p.conf and os.path.exists(f) and not is_generated(f):
                keep = p.conf + ".hand"
                if not os.path.exists(keep):
                    os.rename(f, keep)
            unlink(f)
        except OSError as e:
            reasons.append(f"removing {f}: {e}")
    clear_graph(p)
    rec["result"] = "fail"
    rec["reasons"] = reasons


def is_generated(path):
    try:
        with open(path) as f:
            return f.readline().startswith(GENERATED)
    except OSError:
        return False


def cmd_run(args, p):
    live = not p.root
    rec = {"version": VERSION, "result": "fail", "time": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "reasons": [],
           "board": "-", "unit": unit_id(args.dt), "kernel": os.uname().release, "bundle_digest": "-", "macos_build": "-", "aid": "-",
           "speaker_id": speaker_id_raw(args.dt), "compiler": "-", "source": "-", "params_sha256": "-",
           "compiled": False, "seat_user": "-", "seat_how": "-"}
    try:
        ensure_dir(p.state, 0o755, live)
        ensure_dir(p.etc, 0o755, live)
        override = read_kv(p.override)
        rec["board"] = board_of(args.dt)
        key, want_card = machine_of(args.dt)
        src, sargs = source_args(args, override)
        cli = tuning_cli(args)
        ident = identify(cli, sargs)
        rec.update(bundle_digest=ident["digest"], macos_build=ident.get("macos_build") or "-", aid=ident.get("aid", "-"),
                   source=ident.get("source", src), compiler=f"{ident.get('reader')}:{sha256_file(cli)[:16]}")
        old = read_kv(p.bind)
        have = os.path.exists(p.params)
        rec["params_sha256"] = sha256_file(p.params) if have else "-"
        stale = [k for k in BIND_KEYS if str(rec[k]) != old.get(k)]
        if args.force or not have or stale or old.get("result") != "pass":
            why = "forced" if args.force else ("no blob" if not have else f"changed: {', '.join(stale) or 'result'}")
            log(f"compiling {rec['aid']} (macOS {rec['macos_build']}) for {rec['board']} on {rec['kernel']} ({why})")
            for line in compile_blob(cli, sargs, p.params).splitlines():
                log(line)
            rec["params_sha256"] = sha256_file(p.params)
            rec["compiled"] = True
        else:
            log(f"the blob is bound to {rec['board']}, {rec['kernel']}, {rec['aid']} from macOS {rec['macos_build']}: not recompiling")
        user, how = resolve_seat_user(p, override, etc=args.etc)
        pw = pwd.getpwnam(user)
        rec.update(seat_user=user, seat_how=how)
        idx, card = find_card(want_card, args.card_wait)
        pcm = speaker_pcm(idx)
        write_conf(p, conf_text(rec, key, user, pw.pw_uid, card, pcm, p, src))
        if how == "seat0":
            write_atomic(p.seat_last, user + "\n")
        rec["result"] = "pass"
    except Failed as e:
        rec["reasons"].append(str(e))
    except Exception as e:  # noqa: BLE001 - every failure is a failing record
        rec["reasons"].append(f"internal error: {type(e).__name__}: {e}")
    if rec["reasons"]:
        fail_closed(p, rec, rec["reasons"])
    try:
        os.makedirs(p.state, exist_ok=True)
        write_atomic(p.report, json.dumps(rec, indent=1) + "\n")
        write_atomic(p.bind, "".join(f"{k}={rec[k]}\n" for k in ["result", *BIND_KEYS]))
    except OSError as e:
        log(f"writing the record: {e}")
        return 1
    if rec["result"] != "pass":
        log(f"FAILED on {rec['board']} ({rec['kernel']}); speakerguardd will not start and the speakers stay at the kernel's floor:")
        for r in rec["reasons"]:
            for i, line in enumerate(r.splitlines()):
                log(("  - " if i == 0 else "    ") + line)
        return 1
    log(f"provisioned {rec['board']}: blob {rec['params_sha256'][:12]} ({'compiled' if rec['compiled'] else 'bound'}), "
        f"seat user {rec['seat_user']} ({rec['seat_how']}), {p.conf}")
    return 0


def write_conf(p, text):
    """Provisioning owns the file. One written by hand (from before
    provisioning) is kept once beside it, then replaced."""
    if os.path.exists(p.conf) and not is_generated(p.conf):
        keep = p.conf + ".hand"
        if not os.path.exists(keep):
            os.rename(p.conf, keep)
            log(f"{p.conf} was written by hand; kept as {keep}, and replaced")
    write_atomic(p.conf, text)


# ------------------------------------------------------------------ graph


def clear_graph(p):
    for d in ("pipewire", "wireplumber"):
        for f in glob.glob(os.path.join(p.graph, d, "*.conf")):
            unlink(f)
    if os.path.isdir(p.graph):
        try:
            write_atomic(p.graph_state, "result=fail\n")
        except OSError:
            pass


def graph_digest(p):
    h = hashlib.sha256()
    for f in sorted(glob.glob(os.path.join(p.graph, "*", "*.conf"))):
        h.update(os.path.relpath(f, p.graph).encode() + b"\0")
        with open(f, "rb") as fh:
            h.update(fh.read())
    return h.hexdigest()


def user_systemctl(user, *a):
    """The user's own service manager, reached as that user on the user's
    bus. Not `systemctl --user --machine=USER@`: that goes through machined
    and the system bus broker, which has to write to the caller's output,
    and from a system unit (output captured into a pipe) the broker is not
    allowed to, so the call fails and the graph never reaches a session
    that is already running (an automatic login, for one)."""
    try:
        pw = pwd.getpwnam(user)
    except KeyError:
        return subprocess.CompletedProcess([], 1, "", f"no user {user}")
    rt = f"/run/user/{pw.pw_uid}"
    if not os.path.exists(os.path.join(rt, "bus")):
        return subprocess.CompletedProcess([], 1, "", f"{user} has no user bus")
    env = {"PATH": os.environ.get("PATH") or "/usr/bin:/bin", "HOME": pw.pw_dir, "USER": user, "LOGNAME": user,
           "XDG_RUNTIME_DIR": rt, "DBUS_SESSION_BUS_ADDRESS": f"unix:path={rt}/bus"}
    cmd = ["setpriv", f"--reuid={pw.pw_uid}", f"--regid={pw.pw_gid}", "--init-groups", "--",
           "systemctl", "--user", *a]
    return subprocess.run(cmd, capture_output=True, text=True, timeout=60, env=env, stdin=subprocess.DEVNULL)


def cmd_activate(args, p):
    """The self-check passed: generate the graph from its record, then
    bring the seat user's session onto it."""
    conf = read_kv(p.conf)
    if not conf.get("SGV2_USER"):
        log(f"{p.conf} names no seat user: provisioning has not passed")
        return 1
    os.makedirs(p.graph, mode=0o755, exist_ok=True)
    old = read_kv(p.graph_state)
    before = graph_digest(p) if old.get("result") == "pass" else None
    gen = [os.path.join(HERE, "speakerguardd-selfcheck"), "generate", "--state", p.state,
           "--pipewire-dir", os.path.join(p.graph, "pipewire"), "--wireplumber-dir", os.path.join(p.graph, "wireplumber")]
    r = subprocess.run([sys.executable, "-I", *gen], capture_output=True, text=True, timeout=60)
    if r.returncode != 0:
        clear_graph(p)
        log(f"generating the graph failed: {r.stderr.strip()[-500:]}")
        return 1
    digest = graph_digest(p)
    changed_us = old.get("changed_us") if before == digest and old.get("changed_us") else str(time.monotonic_ns() // 1000)
    write_atomic(p.graph_state, f"result=pass\nuser={conf['SGV2_USER']}\ndigest={digest}\nchanged_us={changed_us}\n")
    log(f"graph for {conf.get('SGV2_MACHINE')} in {p.graph} ({'unchanged' if before == digest else 'new'})")
    if p.root:
        return 0
    refresh_session(conf["SGV2_USER"], int(changed_us), args.graph_unit)
    return 0


def refresh_session(user, changed_us, graph_unit):
    """If the seat user's PipeWire is running and started before the graph
    changed, link the graph and restart it, so it loads the graph now."""
    r = user_systemctl(user, "show", "pipewire.service", "--property=ActiveState", "--property=ActiveEnterTimestampMonotonic")
    if r.returncode != 0:
        log(f"{user} has no running session ({(r.stderr or '').strip()[-200:] or 'systemctl failed'}): the graph loads at their next login")
        return
    props = dict(l.split("=", 1) for l in r.stdout.splitlines() if "=" in l)
    if props.get("ActiveState") != "active":
        return
    if int(props.get("ActiveEnterTimestampMonotonic") or 0) >= changed_us:
        return
    log(f"{user}'s PipeWire started before the graph changed: restarting it on the new graph")
    user_systemctl(user, "start", graph_unit)
    user_systemctl(user, "try-restart", "pipewire.service", "wireplumber.service", "pipewire-pulse.service")


def user_conf_dirs():
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    return {"pipewire": os.path.join(base, "pipewire", "pipewire.conf.d"),
            "wireplumber": os.path.join(base, "wireplumber", "wireplumber.conf.d")}


def cmd_graph_user(args, p):
    """In the user's session, before PipeWire: link the graph for the seat
    user, and remove the links for every other user. Never fails: a missing
    graph only means no speakers for this session."""
    conf = read_kv(p.conf)
    st = read_kv(p.graph_state)
    seat = conf.get("SGV2_UID") == str(os.getuid()) and st.get("result") == "pass"
    want = {}
    if seat:
        for d in ("pipewire", "wireplumber"):
            for f in sorted(glob.glob(os.path.join(p.graph, d, "*.conf"))):
                want[(d, os.path.basename(f))] = f
    prefixes = tuple({os.path.join(p.graph, ""), os.path.join(os.path.realpath(p.graph), "")})
    for d, cdir in user_conf_dirs().items():
        try:
            names = os.listdir(cdir)
        except OSError:
            names = []
        for n in names:
            path = os.path.join(cdir, n)
            if not os.path.islink(path):
                continue
            target = os.readlink(path)
            if target.startswith(prefixes) and want.get((d, n)) != target:
                unlink(path)
                log(f"removed {path}")
        for (dd, n), target in want.items():
            if dd != d:
                continue
            path = os.path.join(cdir, n)
            if os.path.islink(path) and os.readlink(path) == target:
                continue
            if os.path.lexists(path):
                log(f"{path} exists and is not speakerguardd's: leaving it, so the graph does not load")
                continue
            os.makedirs(cdir, exist_ok=True)
            os.symlink(target, path)
            log(f"linked {path}")
    if not seat:
        log(f"uid {os.getuid()} is not the seat user ({conf.get('SGV2_USER', 'none provisioned')}): no speaker graph here")
    return 0


def cmd_is_seat(args, p):
    """The session helper runs for the seat user, once this boot's
    provisioning and self-check passed (the graph is in place; after a boot
    without v2 there is none, and the configuration in /etc is stale)."""
    conf = read_kv(p.conf)
    if conf.get("SGV2_UID") != str(os.getuid()):
        log(f"uid {os.getuid()} is not the seat user ({conf.get('SGV2_USER', 'none provisioned')}): not starting")
        return 1
    if read_kv(p.graph_state).get("result") != "pass":
        log("speakerguardd v2 is not provisioned in this boot (no speaker graph): not starting")
        return 1
    return 0


def cmd_seat(args, p):
    """seat0 changed. A regular user other than the provisioned one is
    active there: restart the supervisor, which provisions for them."""
    override = read_kv(p.override)
    if override.get("SGV2_SEAT_USER"):
        return 0
    user = seat0_user(uid_range(os.path.join(args.etc, "login.defs")))
    if not user:
        return 0
    write_atomic(p.seat_last, user + "\n")
    provisioned = read_kv(p.conf).get("SGV2_USER")
    if provisioned == user:
        return 0
    if subprocess.run(["systemctl", "is-enabled", "--quiet", args.unit]).returncode != 0:
        log(f"{user} is on seat0; {args.unit} is not enabled, so nothing to provision")
        return 0
    log(f"{user} is on seat0 now (provisioned: {provisioned or 'nobody'}): restarting {args.unit}")
    subprocess.run(["systemctl", "restart", "--no-block", args.unit])
    return 0


def cmd_status(args, p):
    for path in (p.report, p.selfcheck_json):
        try:
            with open(path) as f:
                print(f"{path}:\n{f.read()}")
        except OSError as e:
            print(f"{path}: {e}")
    return 0


def main():
    ap = argparse.ArgumentParser(prog="speakerguardd-provision")
    ap.add_argument("cmd", choices=["run", "activate", "seat", "graph-user", "is-seat", "status"])
    ap.add_argument("--bundle", help="the tuning source (default: the installer's bundle)")
    ap.add_argument("--force", action="store_true", help="compile even if the blob is bound")
    ap.add_argument("--unit", default="speakerguardd.service", help="the supervisor's unit (seat)")
    ap.add_argument("--graph-unit", default="speakerguardd-graph.service", help="the user's graph unit (activate)")
    ap.add_argument("--root", default=os.environ.get("SGV2_PROVISION_ROOT", ""), help="test root for every file written")
    ap.add_argument("--tuning-cli", default="aurora-speaker-tuning")
    ap.add_argument("--dt", default=DT)
    ap.add_argument("--etc", default="/etc", help="where login.defs and the display managers' files are")
    ap.add_argument("--card-wait", type=float, default=20.0)
    args = ap.parse_args()
    p = Paths(args.root)
    return {"run": cmd_run, "activate": cmd_activate, "seat": cmd_seat, "graph-user": cmd_graph_user,
            "is-seat": cmd_is_seat, "status": cmd_status}[args.cmd](args, p)


if __name__ == "__main__":
    sys.exit(main())
