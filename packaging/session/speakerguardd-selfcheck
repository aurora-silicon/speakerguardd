REGMAP = "/sys/kernel/debug/regmap"


def _regmap_dump(path, regs):
    """{reg: value} from the whole debugfs dump (every readable register)."""
    try:
        with open(path) as f:
            text = f.read()
    except OSError as e:
        raise wiring.Refused(f"cannot read {path}: {e.strerror} (debugfs is needed for the slot check)")
    out = {}
    for line in text.splitlines():
        k, _, v = line.partition(":")
        try:
            r = int(k, 16)
        except ValueError:
            continue
        if r in regs:
            out[r] = int(v.strip(), 16)
    return out


def regmap_values(i2c, regs):
    """{reg: value} from the amp's regmap in debugfs, reading only `regs`.

    The dump is fixed-width lines ("<reg>: <value>"), and the kernel reads
    only the registers whose lines a read covers. Reading it whole reads
    every register of every page over I2C (about 0.33 s per amp on the
    J616s, 2 s of every check) and fills the register cache with all of
    them. So each wanted register's line is read on its own, at its offset
    if every register before it is in the dump (the line names its
    register, and is checked); anything else reads the whole dump."""
    path = f"{REGMAP}/{i2c}/registers"
    try:
        fd = os.open(path, os.O_RDONLY | os.O_CLOEXEC)
    except OSError as e:
        raise wiring.Refused(f"cannot read {path}: {e.strerror} (debugfs is needed for the slot check)")
    try:
        first = os.pread(fd, 64, 0).decode(errors="replace").split("\n", 1)[0]
        k, sep, _ = first.partition(": ")
        if not sep or int(k, 16) != 0:
            raise ValueError(first)
        width = len(first) + 1
        out = {}
        for r in sorted(regs):
            line = os.pread(fd, width, r * width).decode(errors="replace")
            k, sep, v = line.rstrip("\n").partition(": ")
            if not sep or int(k, 16) != r:
                raise ValueError(line)
            out[r] = int(v, 16)
        return out
    except (OSError, ValueError):
        return _regmap_dump(path, regs)
    finally:
        os.close(fd)


def check_registers(w):
    """Every amp answers on the slots the map gives it."""
    errs, seen = [], []
    for p, a in enumerate(w["amps"]):
        regs = AMP_REGS.get(a["family"])
        if regs is None:
            errs.append(f"{a['prefix']}: no register check for {a['family']} amps")
            continue
        rx_reg, rx_mask, vsns, isns = regs
        if not a.get("i2c"):
            errs.append(f"{a['prefix']}: not bound to an I2C device")
            continue
        r = regmap_values(a["i2c"], {rx_reg, vsns, isns})
        if len(r) != 3:
            errs.append(f"{a['prefix']} ({a['i2c']}): registers {sorted(r)} only")
            continue
        rx = r[rx_reg] & rx_mask
        seen.append((a["prefix"], a["i2c"], r[rx_reg], r[vsns], r[isns]))
        if rx != p:
            errs.append(f"{a['prefix']} ({a['i2c']}) receives TDM slot {rx}, the map plays it on speaker channel {p}")
        for reg, ch, what in ((vsns, a["v_ch"], "V"), (isns, a["i_ch"], "I")):
            v = r[reg]
            if not v & 0x40:
                errs.append(f"{a['prefix']}: {what} sense transmit is disabled")
            elif (v & 0x3F) * 8 // wiring.SENSE_BITS != ch or (v & 0x3F) * 8 % wiring.SENSE_BITS:
                errs.append(f"{a['prefix']}: {what} sense on TX slot {v & 0x3F}, the device tree gives sense channel {ch}")
    return errs, seen


def stats(raw, n):
    f = len(raw) // (2 * n)
    if f == 0:
        return None
    x = struct.unpack("<%dh" % (f * n), raw[: f * n * 2])
    out = []
    for c in range(n):
        s = x[c::n]
        m = sum(s) / f
        out.append({"distinct": len(set(s)), "rms": round(math.sqrt(sum((v - m) ** 2 for v in s) / f), 2), "mean": round(m, 2)})
    return {"frames": f, "ch": out}


def classify(st):
    return ["live" if c["distinct"] >= LIVE else "quiet" if c["distinct"] <= QUIET else "unclear" for c in st["ch"]]


class Streams:
    """One capture, armed before playback, spans the entire silent test.

    A new capture cannot assume a frame boundary in an already running AOP
    serializer. Keep the capture across all switch steps and playback format
    fallbacks. This proves this lifecycle only, not arbitrary graph reopen
    order. Every playback sample is zero and the grant is held once.
    """

    def __init__(self, ctl, card, spk_dev, sense_dev, amps, rate):
        self.ctl, self.card, self.spk, self.sense, self.amps = ctl, card, spk_dev, sense_dev, amps
        self.rate = rate
        self.fmt = None
        self.idx = None
        self.lease = None
        self.play = None
        self.rec = None
        self.reader = None
        self.capture_cv = threading.Condition()
        self.capture_data = bytearray()
        self.capture_total = 0
        self.capture_error = None
        self.frame_bytes = 4 * amps  # V/I, S16_LE
        self.capture_limit = 2 * rate * self.frame_bytes
        self.capture_deadline = None

    def _play(self, fmt):
        return subprocess.Popen(
            ["aplay", "--fatal-errors", "-q", "-D", f"hw:CARD={self.card},DEV={self.spk}", "-f", fmt, "-c", str(self.amps),
             "-r", str(self.rate), "-t", "raw", "/dev/zero"],
            stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True,
        )

    def _owned(self, proc, dev, direction):
        if proc is None or proc.poll() is not None:
            return False
        st = pcm_status(self.idx, dev, direction)
        return st.get("state") == "RUNNING" and st.get("owner_pid") == str(proc.pid)

    def _ours(self):
        return self._owned(self.play, self.spk, "p")

    def _drain(self):
        try:
            while True:
                chunk = os.read(self.rec.stdout.fileno(), 65536)
                if not chunk:
                    raise EOFError("sense capture ended")
                with self.capture_cv:
                    self.capture_total += len(chunk)
                    self.capture_data.extend(chunk)
                    if len(self.capture_data) > self.capture_limit:
                        del self.capture_data[:-self.capture_limit]
                    self.capture_cv.notify_all()
        except Exception as e:
            with self.capture_cv:
                self.capture_error = str(e)
                self.capture_cv.notify_all()

    def _health(self):
        if self.capture_error:
            raise wiring.Refused(f"sense capture failed: {self.capture_error}")
        if time.monotonic() >= self.capture_deadline:
            raise wiring.Refused("silent switch test exceeded its 30-second capture deadline")
        if not self._owned(self.rec, self.sense, "c"):
            raise wiring.Refused("sense capture stopped or is not owned by the self-check")
        if not self._ours():
            raise wiring.Refused(f"the zero-sample stream on hw:{self.card},{self.spk} stopped during the switch test")
        if self.lease.lapsed or self.lease.err:
            raise wiring.Refused(f"the self-check's own lease lapsed during the switch test ({self.lease.err or 'ETIMEDOUT'})")

    @staticmethod
    def _stop_process(proc, kill=False):
        if proc is None:
            return
        if proc.poll() is None:
            if kill:
                proc.kill()
            else:
                proc.terminate()
            try:
                proc.wait(2)
            except subprocess.TimeoutExpired:
                proc.kill()
                proc.wait(2)

    def start(self, idx):
        self.idx = idx
        self.capture_deadline = time.monotonic() + 30
        self.rec = subprocess.Popen(
            ["arecord", "--fatal-errors", "-q", "-D", f"hw:CARD={self.card},DEV={self.sense}",
             "-f", "S16_LE", "-c", str(2 * self.amps), "-r", str(self.rate),
             "--period-time=10000", "--buffer-time=80000", "-t", "raw", "-"],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        )
        self.reader = threading.Thread(target=self._drain, daemon=True)
        self.reader.start()
        deadline = time.monotonic() + 2
        while not self._owned(self.rec, self.sense, "c"):
            if self.rec.poll() is not None:
                err = self.rec.stderr.read().decode(errors="replace").strip()
                raise wiring.Refused(f"sense capture could not start before playback: {err}")
            if time.monotonic() >= deadline:
                raise wiring.Refused("sense capture did not become owned/RUNNING before playback")
            time.sleep(0.01)
        self.lease = Lease(self.ctl)
        self.lease.start()
        log("holding \"Speaker Protection\" for the silent switch test (zero samples only)")
        last = None
        for fmt in [self.fmt] if self.fmt else ["S24_LE", "S32_LE", "S16_LE"]:
            self.play = self._play(fmt)
            deadline = time.monotonic() + 1.0
            while time.monotonic() < deadline and self.play.poll() is None:
                if pcm_state(idx, self.spk, "p") == "RUNNING":
                    break
                time.sleep(0.01)
            if self._ours():
                self.fmt = fmt
                break
            if self.play.poll() is None and pcm_state(idx, self.spk, "p") == "RUNNING":
                raise wiring.Refused(f"hw:{self.card},{self.spk} runs, but not for the self-check's own stream")
            err = (self.play.communicate(timeout=2)[1] or "").strip() if self.play.poll() is not None else "did not start"
            self._stop_process(self.play)
            self.play.stderr.close()
            self.play = None
            last = err
        if self.play is None:
            raise wiring.Refused(f"the zero-sample stream does not start on hw:{self.card},{self.spk}: {last}")
        time.sleep(0.1)
        self._health()

    def capture(self):
        """Take a fresh, complete-frame window from the continuous capture."""
        time.sleep(SETTLE_S)
        self._health()
        with self.capture_cv:
            start = ((self.capture_total + self.frame_bytes - 1) // self.frame_bytes) * self.frame_bytes
        end = start + round(self.rate * CAPTURE_S) * self.frame_bytes
        deadline = time.monotonic() + 5
        while True:
            self._health()
            with self.capture_cv:
                base = self.capture_total - len(self.capture_data)
                if start < base:
                    raise wiring.Refused("sense capture window was overwritten before it could be checked")
                if self.capture_total >= end:
                    raw = bytes(self.capture_data[start - base:end - base])
                    break
                if time.monotonic() >= deadline:
                    raise wiring.Refused("sense capture did not deliver a complete window within five seconds")
                self.capture_cv.wait(0.05)
        self._health()
        return stats(raw, 2 * self.amps)

    def stop(self):
        """Release both streams and the grant, including partial startup."""
        errors = []
        try:
            self._stop_process(self.play)
        except Exception as e:
            errors.append(str(e))
        try:
            if self.lease is not None:
                self.lease.end()
                self.lease = None
                log("released \"Speaker Protection\" after the switch test")
        except Exception as e:
            errors.append(str(e))
        try:
            # Its data is no longer needed, and once the zero-sample stream
            # has stopped, the sense capture can stall (the MCA Macs: no
            # more frames), where arecord does not act on SIGTERM: it was
            # killed after the full 2 s wait on every such run. End it at
            # once; the kernel closes the substream either way.
            self._stop_process(self.rec, kill=True)
            if self.reader is not None:
                self.reader.join(2)
                if self.reader.is_alive():
                    raise wiring.Refused("sense capture drain did not stop")
        except Exception as e:
            errors.append(str(e))
        for proc in (self.play, self.rec):
            if proc is not None:
                for stream in (proc.stdout, proc.stderr):
                    if stream is not None:
                        stream.close()
        self.play = self.rec = None
        if errors:
            raise wiring.Refused("silent stream cleanup failed: " + "; ".join(errors))


def switch_codes(n):
    """Each of n sense switches' captures: (k, codes), where switch i is off
    in exactly the captures in codes[i]. Every code has two of k captures,
    so no code contains another: a channel quiet in exactly its switch's
    code is quieted by that switch alone. If a second switch also quieted
    it (or the claimed one did not), the channel's quiet captures would be
    the union of two codes (or another code, or none), never the claimed
    code; and a switch that quieted a second channel would show in that
    channel's captures the same way. So the coded test proves what one
    switch at a time does: each switch quiets exactly its claimed channel,
    and every other channel stays live. Measured on every amp of the J413,
    J316s and J616s: with several switches off at once (V and I of one amp
    included) every channel reads as with one switch off (speakerguardd#102).
    k = 0 (one switch at a time) when coding saves no capture."""
    k = 2
    while math.comb(k, 2) < n:
        k += 1
    if k >= n:
        return 0, []
    return k, [frozenset(c) for c in itertools.combinations(range(k), 2)][:n]


def check_sense(ctl, idx, card, devs, w, runs):
    """The switch test. Returns (errors, speaker format)."""
    errs = []
    amps = w["amps"]
    n = len(amps)
    claims = {(s["amp"], s["kind"]): s["pcm"] for s in w["sense"]}
    names = {}
    for a in amps:
        for kind in ("V", "I"):
            names[(a["prefix"], kind)] = f"{a['prefix']} {kind}SENSE Switch"
    saved = {}
    for nm in names.values():
        v = switch_get(card, nm)
        if v is None:
            return [f"no {nm!r} control"], None
        saved[nm] = v
    switches = [(p, a, kind) for p, a in enumerate(amps) for kind in ("V", "I")]
    k, codes = switch_codes(len(switches))
    st = Streams(ctl, card, devs[0], devs[1], n, w["rate"])
    try:
        for nm in saved:
            switch_set(ctl, nm, "on")
        st.start(idx)
        base = st.capture()
        runs["baseline"] = base
        cls = classify(base)
        if any(c != "live" for c in cls):
            errs.append(f"with every sense switch on, sense channels {[k for k, c in enumerate(cls) if c != 'live']} are not live")
            return errs, st.fmt
        if not k:
            for p, a, kind in switches:
                nm = names[(a["prefix"], kind)]
                switch_set(ctl, nm, "off")
                try:
                    s = st.capture()
                finally:
                    switch_set(ctl, nm, "on")
                runs[f"{a['prefix']} {kind}SENSE off"] = s
                cls = classify(s)
                quiet = [k for k, c in enumerate(cls) if c == "quiet"]
                unclear = [k for k, c in enumerate(cls) if c == "unclear"]
                want = claims.get((p, kind))
                if unclear:
                    errs.append(f"{a['prefix']} {kind}SENSE off: sense channels {unclear} neither live nor quiet")
                elif quiet != [want]:
                    errs.append(
                        f"{a['prefix']} {kind}SENSE off quietened sense channel(s) {quiet}; the map has its {kind} on channel {want}"
                    )
        else:
            # Coded: capture j has every switch whose code holds j off.
            quiet_in = {c: set() for c in range(len(cls))}
            unclear_any = False
            for j in range(k):
                off = [i for i, c in enumerate(codes) if j in c]
                for i in off:
                    switch_set(ctl, names[(switches[i][1]["prefix"], switches[i][2])], "off")
                try:
                    s = st.capture()
                finally:
                    for i in off:
                        switch_set(ctl, names[(switches[i][1]["prefix"], switches[i][2])], "on")
                label = ", ".join(f"{switches[i][1]['prefix']} {switches[i][2]}" for i in off)
                runs[f"coded {j}: {label} SENSE off"] = s
                cls = classify(s)
                unclear = [c for c, v in enumerate(cls) if v == "unclear"]
                if unclear:
                    unclear_any = True
                    errs.append(f"coded capture {j} ({label} SENSE off): sense channels {unclear} neither live nor quiet")
                for c, v in enumerate(cls):
                    if v == "quiet":
                        quiet_in[c].add(j)
            if not unclear_any:
                follows = {code: f"{a['prefix']} {kind}" for (p, a, kind), code in zip(switches, codes)}
                claimed = set()
                for (p, a, kind), code in zip(switches, codes):
                    want = claims.get((p, kind))
                    claimed.add(want)
                    got = quiet_in.get(want, set())
                    if got != code:
                        who = follows.get(frozenset(got), "no single switch" if got else "no switch")
                        errs.append(f"{a['prefix']} {kind}SENSE: the map has its {kind} on channel {want}, which went quiet in "
                                    f"captures {sorted(got)}, the switch's are {sorted(code)} (channel {want} follows {who})")
                for c in sorted(set(quiet_in) - claimed):
                    if quiet_in[c]:
                        errs.append(f"sense channel {c}, which the map gives no switch, went quiet in captures {sorted(quiet_in[c])}")
    finally:
        try:
            st.stop()
        finally:
            for nm, v in saved.items():
                try:
                    switch_set(ctl, nm, v)
                    actual = switch_get(card, nm)
                    if actual != v:
                        raise wiring.Refused(f"read back {actual!r}, expected {v!r}")
                except Exception as e:  # every restoration must still be attempted
                    reason = f"restoring {nm}: {e}"
                    log(reason)
                    errs.append(reason)
    return errs, st.fmt


