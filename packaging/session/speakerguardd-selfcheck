PLUGIN_URI = "https://aurora-silicon.org/lv2/sgv2#"
# Where distributions install LV2 bundles; the packaged sgv2.lv2 lives in one.
SYSTEM_LV2 = ("/usr/lib64/lv2", "/usr/lib/lv2", "/usr/local/lib64/lv2", "/usr/local/lib/lv2",
              "/run/current-system/sw/lib/lv2", "/nix/var/nix/profiles/default/lib/lv2")


def _env_lv2_paths(files):
    """LV2_PATH values set in environment files (KEY=VALUE lines)."""
    out = []
    for f in files:
        try:
            with open(f, errors="replace") as fh:
                for line in fh:
                    m = re.match(r"\s*(?:export\s+)?LV2_PATH\s*=\s*['\"]?([^'\"\n]*)", line)
                    if m:
                        out.append((m.group(1), f))
        except OSError:
            pass
    return out


def lv2_shadows(users=None, etc="/etc", environ=None):
    """Every copy of the sgv2 plugin that a user's PipeWire could load
    instead of the packaged one: a bundle in any user's ~/.lv2 (lilv searches
    it before the system directories), or in a directory an LV2_PATH names
    (system-wide, in a user's environment.d, or in this environment) that
    is not a system LV2 directory. Hand installs from bring-up leave such
    copies behind, and an old plugin there runs the speakers with code no
    package shipped. Returns (path, why) pairs."""
    import glob as _glob
    import pwd as _pwd
    environ = os.environ if environ is None else environ
    if users is None:
        users = [(u.pw_name, u.pw_dir) for u in _pwd.getpwall() if u.pw_dir and u.pw_dir not in ("/", "")]
    dirs = []
    for name, home in users:
        dirs.append((os.path.join(home, ".lv2"), f"{name}'s ~/.lv2"))
        envd = sorted(_glob.glob(os.path.join(home, ".config", "environment.d", "*.conf")))
        dirs += [(d, f"LV2_PATH in {f}") for v, f in _env_lv2_paths(envd) for d in v.split(":")]
    etcf = [os.path.join(etc, "environment")] + sorted(_glob.glob(os.path.join(etc, "environment.d", "*.conf")))
    dirs += [(d, f"LV2_PATH in {f}") for v, f in _env_lv2_paths(etcf) for d in v.split(":")]
    if environ.get("LV2_PATH"):
        dirs += [(d, "LV2_PATH in this environment") for d in environ["LV2_PATH"].split(":")]
    system = {os.path.realpath(d) for d in SYSTEM_LV2}
    found, seen = [], set()
    for d, why in dirs:
        if not d or "$" in d or os.path.realpath(d) in system:
            continue
        for man in sorted(_glob.glob(os.path.join(d, "*", "manifest.ttl"))):
            real = os.path.realpath(os.path.dirname(man))
            if real in seen or os.path.dirname(real) in system:
                continue
            try:
                with open(man, errors="replace") as fh:
                    if PLUGIN_URI not in fh.read():
                        continue
            except OSError:
                continue
            seen.add(real)
            found.append((os.path.dirname(man), why))
    return found


def bind_lines(rec):
    keys = ["schema", "version", "result", "board", "kernel", "params_sha256", "wiring", "card", "amps", "sense", "family", "key", "method"]
    out = [f"{k}={rec[k]}" for k in keys]
    if rec["reasons"]:
        out.append("reason=" + rec["reasons"][0].replace("\n", " "))
    return "\n".join(out) + "\n"


def read_bind(path):
    try:
        with open(path) as f:
            return dict(l.split("=", 1) for l in f.read().splitlines() if "=" in l)
    except OSError:
        return {}


def write_atomic(path, text, mode=0o644):
    tmp = path + ".new"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_CLOEXEC | os.O_NOFOLLOW, mode)
    try:
        os.fchmod(fd, mode)
        os.write(fd, text.encode())
        os.fsync(fd)
    finally:
        os.close(fd)
    os.rename(tmp, path)


def blob_rate(path):
    """The sample rate a parameter blob was compiled for (its header,
    crates/sgv2-core/src/blob.rs: "SGV2PRM\\0" at 0, sample_rate at 24)."""
    with open(path, "rb") as f:
        head = f.read(28)
    if len(head) < 28 or head[:8] != b"SGV2PRM\0":
        raise wiring.Refused(f"{path} is not a speakerguardd parameter blob")
    return int.from_bytes(head[24:28], "little")


def derive_live(args):
    """(hw, wiring, machine description, errors), all from this Mac's
    device tree and tuning. A refusal (an unreadable device tree, a missing
    or old tuning reader, a tuning the derivation cannot place) fails the
    self-check: nothing runs on an unproven map."""
    hw = wiring.read_dt()
    dump = wiring.tuning_dump(args.tuning, args.tuning_cli, strict=True)
    units = wiring.roles(dump)["channels"]
    w = wiring.derive(hw, dump)
    w["method"] = "derived" if w["sense"] else "derived-static"
    desc = wiring.describe(hw, w)
    return hw, w, desc, wiring.role_errors(w, units)


def report_matches(path, bind):
    """The self-check record at `path` is a pass for the same board,
    kernel, parameters and wiring as `bind`."""
    try:
        with open(path) as f:
            r = json.load(f)["record"]
    except (OSError, ValueError, KeyError, TypeError):
        return False
    return r.get("result") == "pass" and all(str(r.get(k)) == bind.get(k) for k in ("board", "kernel", "params_sha256", "wiring"))


def set_deferred(path, text=None):
    """Write (text) or remove (None) the switch-test-pending file."""
    if text is None:
        try:
            os.unlink(path)
        except FileNotFoundError:
            pass
        return
    os.makedirs(os.path.dirname(path), exist_ok=True)
    write_atomic(path, text)


def cmd_run(args):
    """`run`, under an exclusive lock on the state directory: the
    before-login and after-login units never run the check at the same time,
    and never interleave their records."""
    os.makedirs(args.state, exist_ok=True)
    fd = os.open(os.path.join(args.state, "selfcheck.lock"), os.O_RDWR | os.O_CREAT | os.O_CLOEXEC | os.O_NOFOLLOW, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        return run_locked(args)
    finally:
        os.close(fd)


def run_locked(args):
    bind_path = os.path.join(args.state, "selfcheck.bind")
    report_path = os.path.join(args.state, "selfcheck.json")
    kernel = os.uname().release
    rec = {
        "schema": 1, "version": VERSION, "result": "fail", "board": "-", "kernel": kernel,
        "params_sha256": "-", "wiring": "-", "card": "-", "amps": 0, "sense": 0, "family": "-", "key": "-",
        "method": "-", "reasons": [], "time": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
    }
    report = {"record": rec}
    errs = []
    try:
        # Checked on every boot, before a bound pass is reused: the plugin a
        # session loads must be the packaged one.
        for path, why in lv2_shadows():
            errs.append(f"an unpackaged sgv2 LV2 plugin is at {path} ({why}); PipeWire would load it instead of "
                        f"the packaged one. Remove it (a leftover hand install) and reboot")
        rec["params_sha256"] = sha256(args.params)
        hw, w, desc, derr = derive_live(args)
        errs += derr
        if blob_rate(args.params) != w["rate"]:
            errs.append(f"the parameters are compiled for {blob_rate(args.params)} Hz, the tuning's graph runs at {w['rate']} Hz")
        report["machine"] = desc
        rec.update(board=hw["board"], wiring=w["hash"], amps=len(w["amps"]), sense=len(w["sense"]),
                   family=w["family"], key=w["key"], method=w["method"])
        report["wiring"] = w
        old = read_bind(bind_path)
        if (
            not args.force and not errs
            and old.get("result") == "pass" and old.get("version") == str(VERSION)
            and all(old.get(k) == str(rec[k]) for k in ("board", "kernel", "params_sha256", "wiring"))
            # the graph is generated from the record: a bind without its
            # record (lost or removed) is checked again, not reused
            and report_matches(report_path, old)
        ):
            set_deferred(args.deferred)
            log(f"a passing self-check is bound to {hw['board']}, {kernel}, params {rec['params_sha256'][:12]}, wiring {w['hash']}: nothing to do")
            return 0
        idx, card = find_card(hw)
        rec["card"] = card
        if card != desc["card"]:
            errs.append(f"the speaker card is {card}; macaudio names it {desc['card']} from the device tree's model")
        if args.defer and w["method"] == "derived":
            if not errs:
                # No record is written: the previous one stays (stale for
                # this kernel or blob, so neither the supervisor nor the gate
                # accepts it), and no graph is generated (provision activate).
                set_deferred(args.deferred, f"board={hw['board']}\nkernel={kernel}\nparams_sha256={rec['params_sha256']}\n"
                                            f"wiring={w['hash']}\n")
                log(f"no passing self-check for {hw['board']}, {kernel}, params {rec['params_sha256'][:12]}: the silent switch "
                    "test runs after login (speakerguardd-switchtest); no speaker graph and no grant until it passes")
                return 0
            # The cheap checks failed already: the record fails now, before
            # login, without the switch test.
        elif w["method"] == "derived-static":
            errs += static(idx, w, report)
        elif w["method"] == "derived":
            try:
                errs += active(idx, card, w, report, args)
            finally:
                try:
                    os.unlink(MARKER)
                except OSError:
                    pass
    except wiring.Refused as e:
        errs.append(str(e))
    except Exception as e:  # noqa: BLE001 - every failure is a failing record
        errs.append(f"internal error: {type(e).__name__}: {e}")
    rec["reasons"] = errs
    rec["result"] = "fail" if errs else "pass"
    if args.defer:
        # Before login and not deferred (a failure, or a board without
        # sense): nothing is pending. After login the file stays until the
        # unit's ExecStopPost, once the graph is generated.
        try:
            set_deferred(args.deferred)
        except OSError as e:
            log(f"removing {args.deferred}: {e}")
    try:
        write_atomic(report_path, json.dumps(report, indent=1, default=str) + "\n")
        write_atomic(bind_path, bind_lines(rec))
    except OSError as e:
        log(f"writing the record: {e}")
        return 1
    if errs:
        log(f"FAILED on {rec['board']} ({kernel}); the speakers stay at the kernel's floor:")
        for e in errs:
            log(f"  - {e}")
        return 1
    log(f"passed on {rec['board']} ({kernel}, {rec['method']}): wiring {rec['wiring']}, params {rec['params_sha256'][:12]}")
    return 0


def static(idx, w, report):
    """A board without V/I sense (the J700's MAX98360As): no register and
    no sense to read, so nothing about its channel order is observable
    with zero samples. The map is the device tree's and the tuning's, and
    the record says "derived-static". Only the PCM is checked."""
    ids = pcm_ids(idx)
    if ids.get(("Secondary", "p")) != 1:
        raise wiring.Refused(f"the speaker PCM is {ids.get(('Secondary', 'p'))}; the graph expects 1")
    report["static"] = (
        "no V/I sense and no amp registers: the channel order is derived from the device tree and the tuning, "
        "and each amp's side is its SD_MODE strap, which no software can read"
    )
    return []


def active(idx, card, w, report, args=None):
    """The hardware half: registers, then the silent switch test."""
    errs = []
    ids = pcm_ids(idx)
    spk, sense = ids.get(("Secondary", "p")), ids.get(("Speaker Sense", "c"))
    if spk != 1 or (w["sense"] and sense != 2):
        raise wiring.Refused(f"the speaker PCM is {spk} and the sense PCM {sense}; the graph expects 1 and 2")
    # The session helper links nothing while the check runs; a speaker sink
    # PipeWire still holds from before closes once its session manager
    # suspends it (5 s idle by default).
    pcms = ((spk, "p"), (sense, "c")) if w["sense"] else ((spk, "p"),)
    os.makedirs(os.path.dirname(MARKER), exist_ok=True)
    write_atomic(MARKER, f"{os.getpid()}\n")
    deadline = time.monotonic() + PCM_WAIT_S
    while any(pcm_state(idx, dev, d) != "closed" for dev, d in pcms):
        if time.monotonic() > deadline:
            busy = [f"pcm{dev}{d}" for dev, d in pcms if pcm_state(idx, dev, d) != "closed"]
            raise wiring.Refused(f"{', '.join(busy)} stayed in use for {PCM_WAIT_S} s; the self-check needs it to itself")
        time.sleep(0.2)
    reg_errs, regs = check_registers(w)
    errs += reg_errs
    report["registers"] = regs
    mux = "Speaker Playback Mux"
    old_mux = None
    ctl = None
    try:
        ctl = Control(idx, switch=getattr(args, "switch_interface", False))
        r = amixer(card, "cget", f"name={mux}")
        if r.returncode == 0:
            m = re.search(r": values=(\d+)", r.stdout)
            old_mux = m.group(1) if m else None
            amixer(card, "-q", "cset", f"name={mux}", "Secondary")
        runs = {}
        report["runs"] = runs
        sense_errs, fmt = check_sense(ctl, idx, card, (spk, sense), w, runs)
        errs += sense_errs
        report["speaker_format"] = fmt
        errs += format_errors(report.get("machine"), fmt)
    finally:
        if ctl is not None:
            ctl.close()
        if old_mux is not None:
            amixer(card, "-q", "cset", f"name={mux}", old_mux)
    return errs


def format_errors(desc, fmt):
    """The speaker PCM's format, as ALSA took it, against the transport's
    (wiring.describe), which the generated graph will use."""
    if not desc:
        return ["no machine description to check the speaker format against"]
    if fmt is None:
        return [f"the speaker PCM took none of {wiring.FORMAT_ORDER}"]
    if fmt != desc["alsa_format"]:
        return [f"the speaker PCM took {fmt}; the {desc['transport']} transport gives {desc['alsa_format']}"]
    return []


def cmd_pending(args):
    """speakerguardd-switchtest.service's ExecCondition: 0 (run) when the
    run before login deferred the switch test in this boot, 1 (skip)
    otherwise. With --clear (its ExecStopPost, after the graph is generated
    or the check failed): the test is no longer pending, and the sessions
    waiting for it start."""
    if args.clear:
        set_deferred(args.deferred)
        return 0
    if not os.path.exists(args.deferred):
        return 1
    log("the switch test was deferred until after login: running it now")
    return 0


def cmd_check(args):
    b = read_bind(os.path.join(args.state, "selfcheck.bind"))
    want = {"board": wiring.read_dt()["board"], "kernel": os.uname().release, "params_sha256": sha256(args.params)}
    bad = [k for k, v in want.items() if b.get(k) != v]
    if b.get("result") != "pass" or bad or not report_matches(os.path.join(args.state, "selfcheck.json"), b):
        log(f"no passing self-check for this kernel and these parameters (result {b.get('result')}, stale {bad})")
        return 1
    log(f"bound: {b.get('board')} {b.get('kernel')} wiring {b.get('wiring')}")
    return 0


