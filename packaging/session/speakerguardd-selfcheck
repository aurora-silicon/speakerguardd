# 2: the record carries the derived machine description (report "machine").
# 3: the description carries speaker_irq (the speaker sink's period-interrupt
# scheduling, wiring.TRANSPORTS): records of 2 are checked again.
VERSION = 3
STATE = "/var/lib/speakerguardd"
MARKER = "/run/speakerguardd-selfcheck/active"
# The switch test is pending: written by `run --defer` (before login),
# removed by `pending --clear` when speakerguardd-switchtest.service ends,
# and by a `run --defer` that does not defer. In provisioning's runtime
# directory, which outlives each self-check unit (theirs is removed when
# they stop), where every session's graph-user reads it.
DEFERRED = "/run/speakerguardd-graph/selfcheck.deferred"
CAPTURE_S = 0.4
# After a sense switch turns, before the next capture opens.
SETTLE_S = 0.05
LEASE_MS = 50
TICK_S = 0.010
PCM_WAIT_S = 15
# A sense channel is live with at least LIVE distinct values in a capture,
# quiet (an amp's sense switched off: zeros, or a fixed idle pattern) with
# at most QUIET. Measured on the J316 and J413 with digital silence: live
# channels show 40-80 distinct values in 0.4-1 s, switched-off ones 1-3.
LIVE = 16
QUIET = 4

# ALSA control ioctls (include/uapi/sound/asound.h, 64-bit)
_ID_FMT = "IiII44sI"
_ID_SIZE = 64
_VAL_SIZE = 1224
_IFACE_MIXER = 2
_ELEM_WRITE = (3 << 30) | (_VAL_SIZE << 16) | (0x55 << 8) | 0x13
_ELEM_LOCK = (1 << 30) | (_ID_SIZE << 16) | (0x55 << 8) | 0x14

# TAS2764/SN012776 registers (page 0): TDM_CFG3 (RX slots), TDM_CFG5 (VSNS
# slot + enable), TDM_CFG6 (ISNS slot + enable).
TAS2764_RX = 0x0C
TAS2764_VSNS = 0x0E
TAS2764_ISNS = 0x0F
# TAS2770 (sound/soc/codecs/tas2770.h): TDM_CFG_REG3 holds the left RX
# slot in bits 3:0 (macaudio gives each amp a one-slot mask, so left is
# its slot); TDM_CFG_REG5/6 the V and I sense TX slots, enable bit 6.
TAS2770_RX = 0x0D
TAS2770_VSNS = 0x0F
TAS2770_ISNS = 0x10
# Per amp family: (RX register, RX slot mask, V sense register, I sense register).
AMP_REGS = {
    "sn012776": (TAS2764_RX, 0x0F, TAS2764_VSNS, TAS2764_ISNS),
    "tas2770": (TAS2770_RX, 0x0F, TAS2770_VSNS, TAS2770_ISNS),
}


def log(*a):
    print("speakerguardd-selfcheck:", *a, file=sys.stderr, flush=True)


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for b in iter(lambda: f.read(1 << 16), b""):
            h.update(b)
    return h.hexdigest()


# ------------------------------------------------------------------ card


def find_card(hw, dt="/proc/device-tree"):
    """(index, id) of the ALSA card whose device is the DT sound node."""
    want = os.path.realpath(os.path.join(dt, hw["sound"]))
    for d in sorted(os.listdir("/sys/class/sound")):
        if not re.fullmatch(r"card\d+", d):
            continue
        of = f"/sys/class/sound/{d}/device/of_node"
        if os.path.exists(of) and os.path.realpath(of) == want:
            idx = int(d[4:])
            with open(f"/proc/asound/card{idx}/id") as f:
                return idx, f.read().strip()
    raise wiring.Refused(f"no ALSA card for the device tree's {hw['sound']} node (is the kernel's macaudio driver loaded?)")


def pcm_ids(idx):
    out = {}
    for d in os.listdir(f"/proc/asound/card{idx}"):
        m = re.fullmatch(r"pcm(\d+)([pc])", d)
        if m:
            with open(f"/proc/asound/card{idx}/{d}/info") as f:
                info = dict(l.split(": ", 1) for l in f.read().splitlines() if ": " in l)
            # "id: Secondary (*)": the id, then ALSA's marks
            pid = re.sub(r"\s*\(\*\)$", "", info.get("id", "").strip())
            out[(pid, m.group(2))] = int(m.group(1))
    return out


def pcm_status(idx, dev, d):
    """The substream's /proc status as a dict ({"state": "closed"} when
    closed, {} when unreadable)."""
    try:
        with open(f"/proc/asound/card{idx}/pcm{dev}{d}/sub0/status") as f:
            t = f.read()
    except OSError:
        return {}
    if t.strip() == "closed":
        return {"state": "closed"}
    out = {}
    for line in t.splitlines():
        k, sep, v = line.partition(":")
        if sep:
            out.setdefault(k.strip(), v.strip())
    return out


def pcm_state(idx, dev, d):
    st = pcm_status(idx, dev, d)
    if not st:
        return "unknown"
    return st.get("state", "open")


class Control:
    """The card's control device: "Speaker Protection" owned by this process."""

    def __init__(self, idx, switch=False):
        lease_interface(idx, switch)
        self.fd = os.open(f"/dev/snd/controlC{idx}", os.O_RDWR | os.O_CLOEXEC)
        try:
            fcntl.ioctl(self.fd, _ELEM_LOCK, self._id("Speaker Protection"))
        except OSError as e:
            os.close(self.fd)
            if e.errno == errno.EBUSY:
                raise wiring.Refused("\"Speaker Protection\" is owned by another process (stop speakerguardd first)")
            if e.errno == errno.EPERM:
                raise wiring.Refused("taking \"Speaker Protection\" needs root (CAP_SYS_ADMIN)")
            if e.errno == errno.ENOENT:
                raise wiring.Refused("the card has no \"Speaker Protection\" control: not a v2 kernel")
            raise

    @staticmethod
    def _id(name):
        return struct.pack(_ID_FMT, 0, _IFACE_MIXER, 0, 0, name.encode(), 0)

    def write(self, v, name="Speaker Protection"):
        buf = bytearray(_VAL_SIZE)
        buf[0:_ID_SIZE] = self._id(name)
        struct.pack_into("q", buf, 72, v)
        fcntl.ioctl(self.fd, _ELEM_WRITE, buf)

    def close(self):
        # closing the owner's file withdraws any grant at once
        try:
            self.write(0)
        except OSError:
            pass
        os.close(self.fd)


def lease_interface(card, switch=False):
    """On a dual kernel ("Speaker Protection Interface", linux 98cb6a86 and
    later) "Speaker Volume Unlock" is in charge at boot, and "Speaker
    Protection" grants nothing until root switches the interface. The check
    switches it only on a Mac aurora-speaker-upgrade switched (its setting),
    or when that tool runs the check itself (`--switch-interface`); the
    kernel goes back to the volume lock, at its floor, 30 s after the last
    owner closes. Returns the interface ("dual" or None)."""
    cur = wiring.interface_get(card)
    if cur is None:
        return None
    if cur != wiring.IF_LEASE:
        if not (switch or wiring.upgraded()):
            raise wiring.Refused(
                f"this kernel serves both speaker interfaces and {wiring.IF_UNLOCK!r} is in charge: this Mac was not "
                "switched to speakerguardd v2 (aurora-speaker-upgrade), so the older daemons own the speakers")
        wiring.interface_lease(card)
        log(f"{wiring.INTERFACE_CONTROL!r} = {wiring.IF_LEASE!r} (the volume lock's floor first)")
    return "dual"


class Lease(threading.Thread):
    """Renews a LEASE_MS grant every TICK_S until stopped. A lapse (the
    kernel's -ETIMEDOUT) is recorded and the run it spans is void."""

    def __init__(self, ctl):
        super().__init__(daemon=True)
        self.ctl, self.stop_ev, self.lapsed, self.err = ctl, threading.Event(), False, None

    def run(self):
        try:
            os.sched_setscheduler(0, os.SCHED_FIFO, os.sched_param(50))
        except (OSError, AttributeError):
            pass
        while not self.stop_ev.is_set():
            try:
                self.ctl.write(LEASE_MS)
            except OSError as e:
                if e.errno == errno.ETIMEDOUT:
                    self.lapsed = True
                else:
                    self.err = e
                    return
            self.stop_ev.wait(TICK_S)

    def end(self):
        self.stop_ev.set()
        self.join(1.0)
        self.ctl.write(0)


def amixer(card, *args):
    return subprocess.run(["amixer", "-c", card, *args], capture_output=True, text=True, timeout=10)


def switch_get(card, name):
    r = amixer(card, "cget", f"name={name}")
    m = re.search(r": values=(\w+)", r.stdout)
    return m.group(1) if m else None


def switch_set(ctl, name, v):
    # Sense switches are writable only through the protection owner's file.
    # amixer opens another file and is deliberately refused while we own it.
    if v not in ("on", "off"):
        raise wiring.Refused(f"setting {name!r}: invalid switch value {v!r}")
    try:
        ctl.write(int(v == "on"), name=name)
    except OSError as e:
        raise wiring.Refused(f"setting {name!r}: {e}") from e


