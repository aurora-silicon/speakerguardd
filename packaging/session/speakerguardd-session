#!/usr/bin/python3 -I
"""speakerguardd-session: the per-user half of speakerguardd v2.

    speakerguardd-session --machine j316 [--selfcheck /var/lib/speakerguardd/selfcheck.json]

It runs in the user's session, beside PipeWire, and does three things:

1. **Ordering.** It links the speaker amps and the sense to the protect stage
   only while the kernel grants protection ("Speaker Protection" reads 1), and
   unlinks them as soon as it does not. The amps' sink is the driver of their
   group, so it never starts before the grant: the kernel would refuse it.
2. **Integrity.** It checks the link set: into the protect stage's program
   ports anything but the sense, channel for channel (the voicing, or a
   second voicing such as a tuning A/B sink); into its sense ports
   only the sense, channel for channel; into the amps only the protect
   stage's output, channel for channel; out of the sense nothing else. A
   missing link is silence and is allowed; any other link is a fault. It
   also checks the carrier: the protect stage's input and the sense at unity
   volume, unmuted.
3. **Report.** On every link or carrier change, and every 50 ms, it writes
   `links=<0|1> carrier=<0|1> mono_ns=<t> pid=<pid> start=<ticks> wiring=<hash> amps=<0|1>`
   to /run/speakerguardd/<uid>/helper/session, where the wiring is the one
   the protect stage was built with (its `sgv2.wiring` property; the
   supervisor grants only for the wiring the self-check proved), by a write
   to a new file and a
   rename, so the supervisor never reads a partial report. `amps` says whether
   anything is linked into the amps' sink (the sleep step waits for 0). A report older
   than 500 ms, dated in the future, or whose writer (pid, start time) is not
   this live process counts as absent, and the supervisor then releases.
4. **The grant-before-start sequence.** The supervisor grants only on a
   live engine heartbeat (the protect stage runs on PipeWire's dummy driver
   while the amps are unlinked) and a fresh report; this helper links the
   amps only once the kernel reads granted; the amps' sink then starts. On
   any withdrawal it unlinks the amps, the sink stops and closes, and the
   sequence starts again.

It reads the graph from `pw-dump --monitor` and makes or removes links with
`pw-link`. It never touches the amps' volume: the kernel owns it.
"""
import argparse
import fcntl
import json
import os
import select
import signal
import struct
import subprocess
import sys
import time

PERIOD = 0.050
PROTECT_INPUT = "alsa_output.platform-sound.RawSpeakers"
# While speakerguardd-selfcheck runs its silent check it holds a grant of
# its own: nothing may be linked to the amps then.
SELFCHECK_ACTIVE = "/run/speakerguardd-selfcheck/active"
# Before system sleep speakerguardd-sleep.service sets this hold: the amps
# and the sense are unlinked and suspended (their PCMs close) before the
# supervisor stops, and stay so until the resume clears it.
SLEEP_HOLD = "/run/speakerguardd-sleep/hold"

# ALSA control ioctls (include/uapi/sound/asound.h, 64-bit)
_ID_FMT = "IiII44sI"
_VAL_SIZE = 1224
_ELEM_READ = (3 << 30) | (_VAL_SIZE << 16) | (0x55 << 8) | 0x12
_SUBSCRIBE_EVENTS = (3 << 30) | (4 << 16) | (0x55 << 8) | 0x16
_EVENT_SIZE = 72
_IFACE_MIXER = 2


def own_start():
    """This process's start time, /proc/self/stat field 22 (clock ticks
    since boot). With the pid it names the writer of each report, so the
    supervisor can tell a live helper from a stopped one's leftover report."""
    with open("/proc/self/stat") as f:
        stat = f.read()
    return int(stat[stat.rindex(")") + 1 :].split()[19])


def log(*a):
    print("speakerguardd-session:", *a, file=sys.stderr, flush=True)


class Card:
    """Read-only access to the speaker card's "Speaker Protection" control."""

    def __init__(self, card_id):
        try:
            # /proc/asound/<id> is a link to card<N>
            self.index = int(os.readlink(f"/proc/asound/{card_id}").removeprefix("card"))
        except (OSError, ValueError):
            raise SystemExit(f"no ALSA card {card_id}")
        self.fd = os.open(f"/dev/snd/controlC{self.index}", os.O_RDONLY | os.O_CLOEXEC | os.O_NONBLOCK)
        # Control events: a withdrawal is seen at once, not at the next
        # 50 ms period, so the amps are unlinked before the sink keeps
        # retrying a start the kernel refuses.
        try:
            fcntl.ioctl(self.fd, _SUBSCRIBE_EVENTS, struct.pack("i", 1))
            self.events = True
        except OSError:
            self.events = False

    def drain(self):
        """Discard pending control events; True if there were any."""
        got = False
        while True:
            try:
                if not os.read(self.fd, _EVENT_SIZE * 16):
                    return got
                got = True
            except BlockingIOError:
                return got
            except OSError:
                return got

    def granted(self):
        buf = bytearray(_VAL_SIZE)
        buf[0:64] = struct.pack(_ID_FMT, 0, _IFACE_MIXER, 0, 0, b"Speaker Protection", 0)
        try:
            fcntl.ioctl(self.fd, _ELEM_READ, buf)
        except OSError:
            return False
        if os.path.exists(SELFCHECK_ACTIVE) or os.path.exists(SLEEP_HOLD):
            return False
        return struct.unpack_from("q", buf, 72)[0] == 1


class Graph:
    """The PipeWire objects, kept current from `pw-dump --monitor`."""

    def __init__(self):
        self.proc = subprocess.Popen(
            ["pw-dump", "--monitor", "--no-colors"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL
        )
        os.set_blocking(self.proc.stdout.fileno(), False)
        self.buf = ""
        self.dec = json.JSONDecoder()
        self.objs = {}

    def pump(self, timeout, extra=()):
        """Read the monitor's output for up to `timeout`; returns which of
        the `extra` fds are readable."""
        r, _, _ = select.select([self.proc.stdout, *extra], [], [], timeout)
        ready = [fd for fd in extra if fd in r]
        r = [x for x in r if x is self.proc.stdout]
        if r:
            chunk = self.proc.stdout.read()
            if chunk is None:
                return ready
            if chunk == b"":
                raise SystemExit("pw-dump exited")
            self.buf += chunk.decode(errors="replace")
        while True:
            s = self.buf.lstrip()
            if not s:
                self.buf = ""
                return ready
            try:
                arr, end = self.dec.raw_decode(s)
            except ValueError:
                self.buf = s
                return ready
            self.buf = s[end:]
            for o in arr if isinstance(arr, list) else []:
                if o.get("info") is None:
                    self.objs.pop(o.get("id"), None)
                else:
                    old = self.objs.get(o["id"])
                    if old is not None and o.get("type") == old.get("type"):
                        # Updates carry only what changed
                        for k, v in o["info"].items():
                            if k == "params" and isinstance(v, dict):
                                old["info"].setdefault("params", {}).update(v)
                            else:
                                old["info"][k] = v
                    else:
                        self.objs[o["id"]] = o

    def of_type(self, t):
        return [o for o in self.objs.values() if o.get("type", "").endswith(":" + t)]

    def node_id(self, name):
        for o in self.of_type("Node"):
            if (o["info"].get("props") or {}).get("node.name") == name:
                return o["id"]
        return None

    def node_state(self, nid):
        """A node's state ("suspended", "idle", "running", ...), or None."""
        return ((self.objs.get(nid) or {}).get("info") or {}).get("state")

    def node_props(self, nid):
        o = self.objs.get(nid) or {}
        params = (o.get("info") or {}).get("params") or {}
        p = params.get("Props") or []
        return p[0] if p else {}

    def ports(self, nid, direction):
        """{channel: port id} of a node's ports in one direction (no monitor ports)."""
        out = {}
        for o in self.of_type("Port"):
            p = o["info"].get("props") or {}
            if p.get("node.id") != nid or p.get("port.direction") != direction or p.get("port.monitor"):
                continue
            out[p.get("audio.channel")] = o["id"]
        return out

    def links(self):
        return [
            (o["id"], o["info"].get("output-port-id"), o["info"].get("input-port-id"))
            for o in self.of_type("Link")
        ]


def unity(props):
    if not props:
        return False
    if props.get("mute", False):
        return False
    if abs(props.get("volume", 1.0) - 1.0) > 1e-6:
        return False
    return all(abs(v - 1.0) <= 1e-6 for v in props.get("channelVolumes", [1.0]))


class Session:
    def __init__(self, m, c):
        self.m, self.c = m, c
        self.amps, self.sense = c["amps"], c["sense"]
        self.voicing = f"effect_output.{m}-convolver"
        self.protect_out = f"sgv2.protect.{m}.out"
        self.speaker = f"sgv2.speaker.{m}"
        self.sense_name = f"sgv2.sense.{m}"
        self.last_try = -10.0
        self.last_suspend = -10.0
        self.last_unity = -10.0
        self.pending = {}

    def wanted(self, g):
        """The links the helper owns: (out port, in port) pairs, or None if a node is missing."""
        protect = g.node_id(PROTECT_INPUT)
        pout = g.node_id(self.protect_out)
        spk = g.node_id(self.speaker)
        sense = g.node_id(self.sense_name) if self.sense else None
        if None in (protect, pout, spk) or (self.sense and sense is None):
            return None
        pin = g.ports(protect, "in")
        po = g.ports(pout, "out")
        si = g.ports(spk, "in")
        want = []
        for i in range(self.amps):
            a = f"AUX{i}"
            if a not in po or a not in si:
                return None
            want.append((po[a], si[a]))
        if self.sense:
            so = g.ports(sense, "out")
            for i in range(self.sense):
                a, b = f"AUX{i}", f"AUX{self.amps + i}"
                if a not in so or b not in pin:
                    return None
                want.append((so[a], pin[b]))
        return want

    def check(self, g):
        """(links_ok, carrier_ok) for the current graph."""
        protect = g.node_id(PROTECT_INPUT)
        pout = g.node_id(self.protect_out)
        spk = g.node_id(self.speaker)
        sense = g.node_id(self.sense_name) if self.sense else None
        if protect is None or pout is None or spk is None:
            return False, False
        port_info = {}
        for o in g.of_type("Port"):
            p = o["info"].get("props") or {}
            port_info[o["id"]] = (p.get("node.id"), p.get("audio.channel"))
        ok = True
        for _, out_p, in_p in g.links():
            on, oc = port_info.get(out_p, (None, None))
            inn, ic = port_info.get(in_p, (None, None))
            if inn == protect:
                k = int(ic[3:]) if ic and ic.startswith("AUX") else -1
                if 0 <= k < self.amps:
                    # Program: whatever plays into the protect stage is
                    # protected; only its channel must match, and it must not
                    # be the sense.
                    ok &= on != sense and oc == ic
                else:
                    ok &= sense is not None and on == sense and oc == f"AUX{k - self.amps}"
            elif inn == spk:
                ok &= on == pout and oc == ic
            elif sense is not None and on == sense:
                ok = False
        carrier = unity(g.node_props(protect)) and (sense is None or unity(g.node_props(sense)))
        return ok, carrier

    def pin_amps_unity(self, g):
        """The amps' sink carries no volume: the protect stage models exactly
        what reaches the amps, and the user's volume lives in the voicing in
        front of it. A volume or mute set on it (by a session restore, a
        mixer or a script) is put back to unity, at most once a second.
        Returns True when a reset was started."""
        spk = g.node_id(self.speaker)
        props = g.node_props(spk) if spk is not None else {}
        if not props or unity(props):
            return False
        now = time.monotonic()
        if now - self.last_unity < 1.0:
            return False
        self.last_unity = now
        n = max(len(props.get("channelVolumes", [])), self.amps)
        vols = ", ".join(["1.0"] * n)
        log(f"amps sink volume {props.get('volume')} {props.get('channelVolumes')} mute={props.get('mute')}: reset to unity")
        self._spawn(
            ("unity", spk),
            ["pw-cli", "set-param", str(spk), "Props", f"{{ mute: false, volume: 1.0, channelVolumes: [ {vols} ] }}"],
        )
        return True

    def amps_linked(self, g):
        """True while any link feeds the amps' sink."""
        spk = g.node_id(self.speaker)
        if spk is None:
            return False
        owners = {o["id"]: (o["info"].get("props") or {}).get("node.id") for o in g.of_type("Port")}
        return any(owners.get(i) == spk for _, _, i in g.links())

    def wiring(self, g):
        """The protect stage's `sgv2.wiring` (16 hex digits), or None."""
        protect = g.node_id(PROTECT_INPUT)
        props = ((g.objs.get(protect) or {}).get("info") or {}).get("props") or {}
        w = props.get("sgv2.wiring")
        return w if isinstance(w, str) and len(w) == 16 and all(ch in "0123456789abcdef" for ch in w) else None

    def _spawn(self, key, argv):
        """Run pw-link without waiting: the report must not stall behind it."""
        if key in self.pending:
            return
        self.pending[key] = subprocess.Popen(argv, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def unlink_all(self, g, timeout):
        """Take the amps and the sense out of the graph and wait for it, at
        most `timeout` seconds in all, so a stopping helper leaves nothing
        linked and never hangs shutdown."""
        deadline = time.monotonic() + timeout
        self.reconcile(g, False)
        for p in list(self.pending.values()):
            try:
                p.wait(max(0.0, deadline - time.monotonic()))
            except subprocess.TimeoutExpired:
                p.kill()
        self._reap()

    def _reap(self):
        for k, p in list(self.pending.items()):
            if p.poll() is not None:
                del self.pending[k]

    def reconcile(self, g, granted):
        self._reap()
        want = self.wanted(g)
        have = {(o, i): lid for lid, o, i in g.links()}
        if granted and want:
            # A link pw-link could not make is tried again once a second
            now = time.monotonic()
            missing = [w for w in want if w not in have]
            if missing and now - self.last_try >= 1.0:
                self.last_try = now
                for o, i in missing:
                    self._spawn(("link", o, i), ["pw-link", str(o), str(i)])
        elif not granted:
            # Withdrawn: take the amps and the sense out of the graph, so the
            # amps' sink is not started again until the next grant.
            spk = g.node_id(self.speaker)
            sense = g.node_id(self.sense_name) if self.sense else None
            owners = {o["id"]: (o["info"].get("props") or {}).get("node.id") for o in g.of_type("Port")}
            linked = False
            for lid, o, i in g.links():
                if owners.get(i) == spk or (sense is not None and owners.get(o) == sense):
                    linked = True
                    self._spawn(("unlink", lid), ["pw-link", "-d", str(lid)])
            if os.path.exists(SLEEP_HOLD) and not linked:
                self.suspend_for_sleep(g, (spk, sense))

    def suspend_for_sleep(self, g, nodes):
        """Under the sleep hold, once nothing is linked: suspend the amps'
        sink and the sense, which closes their PCMs. Unlinked they are only
        paused, and WirePlumber closes an idle node after 5 s, after the
        sleep has begun; a PCM held open across a sleep is unmuted by the
        resume before its I2S clocks are back (the MCA loses its state in
        sleep). speakerguardd-provision sleep waits for the PCMs to read
        closed. Sent again every 0.5 s while a node is not suspended."""
        now = time.monotonic()
        if now - self.last_suspend < 0.5:
            return
        for nid in nodes:
            if nid is not None and g.node_state(nid) not in (None, "suspended"):
                self.last_suspend = now
                # the node's Suspend command (pw-cli 1.x: id, command, args)
                self._spawn(("suspend", nid), ["pw-cli", "send-command", str(nid), "Suspend", "{}"])


_WRITER = None


def realtime():
    """Best effort: low SCHED_FIFO if RLIMIT_RTPRIO allows it (PipeWire's
    limits.d grants it to its group), else a higher nice if allowed. Either
    keeps the report on time under desktop load; without them the
    supervisor's 500 ms report bound absorbs a late report. The engine,
    PCM and owner checks never depend on this process's timing."""
    try:
        os.sched_setscheduler(0, os.SCHED_FIFO, os.sched_param(5))
        log("SCHED_FIFO 5")
        return
    except (OSError, AttributeError):
        pass
    try:
        os.nice(-10)
        log("nice -10")
    except OSError:
        log("normal priority (no RLIMIT_RTPRIO or CAP_SYS_NICE)")


def write_report(path, links, carrier, wiring=None, amps=None):
    """Write one report atomically: a new file in the helper's own
    directory, renamed over the last one. The supervisor reads either the
    whole new report or the whole previous one, never a partial write.
    It names its writer (pid, start time): the supervisor ignores a report
    whose writer is not alive."""
    global _WRITER
    if _WRITER is None:
        _WRITER = (os.getpid(), own_start())
    pid, start = _WRITER
    w = f" wiring={wiring}" if wiring else ""
    # amps: whether anything is linked into the amps' sink (speakerguardd-sleep
    # waits for 0 before the supervisor stops)
    if amps is not None:
        w += f" amps={int(amps)}"
    line = f"links={int(links)} carrier={int(carrier)} mono_ns={time.monotonic_ns()} pid={pid} start={start}{w}\n".encode()
    tmp = os.path.join(os.path.dirname(path), f".session.{os.getpid()}")
    try:
        # 0640: the directory is setgid root, so the supervisor reads it
        # through the group (it runs without CAP_DAC_OVERRIDE)
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_CLOEXEC | os.O_NOFOLLOW, 0o640)
        try:
            os.fchmod(fd, 0o640)
            os.write(fd, line)
        finally:
            os.close(fd)
        os.rename(tmp, path)
        return True
    except OSError:
        return False


def machine(args):
    """The machine's card and channel counts, from the self-check's record
    (derived from this Mac's device tree and proven on it)."""
    try:
        with open(args.selfcheck) as f:
            rec = json.load(f)["record"]
    except (OSError, ValueError, KeyError) as e:
        raise SystemExit(f"{args.machine}: no self-check record ({e})")
    if rec.get("key") != args.machine or rec.get("result") != "pass":
        raise SystemExit(f"{args.machine}: the self-check record is for {rec.get('key')} ({rec.get('result')})")
    return {"card": rec["card"], "amps": rec["amps"], "sense": rec["sense"]}


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--machine", required=True)
    ap.add_argument("--selfcheck", default="/var/lib/speakerguardd/selfcheck.json")
    args = ap.parse_args()
    c = machine(args)
    card = Card(c["card"])
    g = Graph()
    s = Session(args.machine, c)
    report = f"/run/speakerguardd/{os.getuid()}/helper/session"

    def stop(*_):
        # a stopped helper leaves no report behind (the supervisor releases
        # at once), and no amps or sense linked, so the sink does not keep
        # retrying a refused start until PipeWire restarts; the unlink is
        # bounded to 1 s
        try:
            os.unlink(report)
        except OSError:
            pass
        try:
            s.unlink_all(g, 1.0)
        except Exception as e:  # noqa: BLE001 - shutting down regardless
            log(f"unlink on stop: {e}")
        raise SystemExit(0)

    realtime()
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    last = (None, None, None, None)
    was_granted = None
    nxt = time.monotonic()
    while True:
        ready = g.pump(max(0.0, nxt - time.monotonic()), [card.fd] if card.events else [])
        if ready and card.drain():
            # a grant or a withdrawal: link or unlink now
            granted = card.granted()
            if granted != was_granted:
                s.reconcile(g, granted)
                was_granted = granted
        if time.monotonic() < nxt:
            # event-driven: a link or carrier change is reported at once,
            # not at the next period
            if ready is not None and s.check(g) != last[1:3]:
                nxt = time.monotonic()
            else:
                continue
        nxt += PERIOD
        if nxt < time.monotonic():
            nxt = time.monotonic() + PERIOD
        granted = card.granted()
        links, carrier = s.check(g)
        wrote = write_report(report, links, carrier, s.wiring(g), s.amps_linked(g))
        s.reconcile(g, granted)
        s.pin_amps_unity(g)
        was_granted = granted
        state = (granted, links, carrier, wrote)
        if state != last:
            log(f"granted={int(granted)} links={int(links)} carrier={int(carrier)} report={'ok' if wrote else 'unwritable'}")
            last = state


if __name__ == "__main__":
    main()
