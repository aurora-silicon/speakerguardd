#!/usr/bin/python3 -I
"""speakerguardd-gate: whether speakerguardd v2 runs on this Mac.

    speakerguardd-gate prepare|v2      [--gate F] [--wait S]
    speakerguardd-gate explain [--gate F] [--wait S]
    speakerguardd-gate interface       [--wait S]

speakerguardd v2 is the only speaker protection. This program is the
ExecCondition of its units, decided at every boot:

- v2 runs (`v2` exits 0) only with current successful compilation, own-Mac
  extraction provenance, a silent wiring self-check bound to this board,
  kernel and blob, and every protection type (including LSID) at parity.
  Board policy may deny, but an allow never bypasses those proofs. A
  protection type gate.json releases only with protected playback rows
  (units_need_playback_rows: LSID's static release) also needs those rows
  on record for this speaker (its AID).
- `prepare` admits provisioning and the silent check before those records
  exist, when the graph's protection types are at parity and not denied.
- anywhere else no speaker daemon runs at all, and the kernel holds the
  speakers at its own safe limit: an unqualified board, a kernel without
  the v2 interface, a speaker card whose controls cannot be read. There is
  no fallback to an older daemon (speakerguardd 0.1, speakersafetyd); none
  is ever started or handed the speakers.
- a dual kernel (macaudio's root-only "Speaker Protection Interface"
  control, default "Speaker Volume Unlock" at every bind) serves both
  interfaces. There v2 runs only when the upgrade's persistent setting
  (/var/lib/aurora-speaker-upgrade/interface, written by
  aurora-speaker-upgrade after `speakerguardd-selfcheck verify` passed) says
  "v2" and every proof above holds; otherwise nothing runs and the kernel's
  volume lock holds the speakers. `interface` (the supervisor's
  ExecStartPre, after this condition passed) writes the control on every
  start: the kernel goes back to the volume lock 30 s after the last owner
  of "Speaker Protection" closes.

`legacy` is still accepted and always answers no (exit 1): a leftover
drop-in from an older package (legacy-gate.conf on speakersafetyd.service
or speakerguardd 0.1's unit) then skips that daemon instead of failing.

The data (gate.json) comes from speakerguardd itself and is the same in
every distribution; everything about the hardware comes from the Mac.

Exit 0: start the unit. Exit 1: skip it (systemd logs the condition).
The reason goes to stderr, so the journal says why.
"""
import argparse
import json
import os
import re
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)
import gen  # noqa: E402
import wiring  # noqa: E402
DT = "/proc/device-tree"
# The bundle provisioning compiles when the installer's copy is not where the
# reader looks first (speakerguardd-provision: SGV2_BUNDLE=<path>).
PROVISION_CONF = "/etc/speakerguardd/provision.conf"
CONTROL = "Speaker Protection"
# The dual kernel's selector (linux#1279) and the upgrade's persistent choice.
INTERFACE_CONTROL = "Speaker Protection Interface"
UPGRADE_SETTING = "/var/lib/aurora-speaker-upgrade/interface"


def log(*a):
    print("speakerguardd-gate:", *a, file=sys.stderr, flush=True)


def board_of(dt):
    try:
        with open(os.path.join(dt, "compatible"), "rb") as f:
            first = f.read().split(b"\0", 1)[0].decode()
    except (OSError, UnicodeDecodeError):
        return None
    return first[len("apple,"):] if first.startswith("apple,") and len(first) > 6 else None


def bundle_override(path):
    """SGV2_BUNDLE from provisioning's configuration, or None."""
    try:
        with open(path) as f:
            for line in f:
                line = line.strip()
                if line.startswith("SGV2_BUNDLE="):
                    v = line.split("=", 1)[1].strip()
                    if len(v) >= 2 and v[0] == v[-1] and v[0] in "\"'":
                        v = v[1:-1]
                    return v or None
    except OSError:
        pass
    return None


def tuning_units(cli, conf=None):
    """The complete protection type set from provisioning's own source."""
    bundle = bundle_override(conf or PROVISION_CONF)
    return wiring.protection_units(wiring.tuning_dump([bundle] if bundle else [], cli, strict=True))


def tuning_aid(cli, conf=None):
    """The speaker identity (AID<n>) of provisioning's own source, as the
    tuning reader's identify names it."""
    bundle = bundle_override(conf or PROVISION_CONF)
    r = subprocess.run([cli, "identify", "--json", *([bundle] if bundle else [])], capture_output=True, text=True,
                       timeout=120)
    try:
        v = json.loads(r.stdout)
    except ValueError:
        raise wiring.Refused(f"the tuning reader's identify gave no JSON (exit {r.returncode})") from None
    if r.returncode != 0 or not isinstance(v, dict) or "error" in v or not isinstance(v.get("aid"), str):
        raise wiring.Refused(f"the tuning reader could not identify the speaker (exit {r.returncode})")
    return v["aid"]


SYSFS = "/sys/class/sound"
PROC = "/proc/asound"


def speaker_card(sysfs=SYSFS, proc=None):
    """The speaker card's ALSA id: the card whose device tree node is a
    macaudio sound node with the speaker link, looked for among all cards
    (the J614s/J616s/J713 also have a jack-only macaudio card, and either may
    probe first). A card counts once ALSA has registered it in full
    (wiring.card_registered): before that its controls cannot be read."""
    try:
        names = sorted(os.listdir(sysfs))
    except OSError:
        return None
    for d in names:
        if not re.fullmatch(r"card\d+", d) or not wiring.card_registered(f"{sysfs}/{d}", proc or PROC):
            continue
        node = f"{sysfs}/{d}/device/of_node"
        try:
            with open(f"{node}/compatible", "rb") as f:
                compat = f.read().split(b"\0")
            if b"apple,macaudio" not in compat or not wiring.has_speaker_link(node):
                continue
            with open(f"{sysfs}/{d}/id") as f:
                return f.read().strip()
        except OSError:
            continue
    return None


def dt_speaker_node(dt=DT):
    """Whether the live device tree describes a speaker card at all: True
    for an enabled apple,macaudio node at the root with the speaker link
    (where wiring.read_dt looks), False when the tree is readable and has
    none, None when the tree cannot be read. With False no speaker card can
    register, so there is nothing to wait for."""
    try:
        names = os.listdir(dt)
    except OSError:
        return None
    for d in names:
        p = os.path.join(dt, d)
        try:
            with open(os.path.join(p, "compatible"), "rb") as f:
                compat = f.read().split(b"\0")
        except OSError:
            continue
        if b"apple,macaudio" not in compat:
            continue
        try:
            with open(os.path.join(p, "status"), "rb") as f:
                if f.read().rstrip(b"\0") not in (b"okay", b"ok"):
                    continue
        except FileNotFoundError:
            pass
        except OSError:
            return None
        try:
            if wiring.has_speaker_link(p):
                return True
        except OSError:
            return None
    return False


def upgrade_setting(path=None):
    """The upgrade's persistent interface choice: "v2", None (not switched),
    or "unreadable" (it exists but this process may not read it: the
    store is root only, so a gate not running as root cannot know)."""
    path = path or UPGRADE_SETTING
    try:
        with open(path) as f:
            v = f.read().strip()
    except FileNotFoundError:
        return None
    except PermissionError:
        return "unreadable"
    except OSError:
        return "unreadable" if os.path.lexists(os.path.dirname(path)) else None
    return v if v == "v2" else None


# amixer's message when the card opened but has no such control
# (snd_ctl_elem_info() failed); alsa-utils does not translate it.
NO_SUCH_CONTROL = "Cannot find the given element"


def has_control(card, name):
    """True when the card has the control, False only when amixer opened
    the card and found no such control, None when it could not tell (the
    card could not be found or opened, amixer failed or timed out): an
    answer that only says the check could not run is never "no control"."""
    try:
        r = subprocess.run(["amixer", "-c", card, "cget", f"name={name}"], capture_output=True, text=True,
                           timeout=10, env={**os.environ, "LC_ALL": "C"})
    except (OSError, subprocess.TimeoutExpired) as e:
        log(f"amixer: {e}")
        return None
    if r.returncode == 0:
        return True
    if NO_SUCH_CONTROL in r.stderr:
        return False
    log(f"amixer -c {card} cget name={name!r}: exit {r.returncode}: {r.stderr.strip()}")
    return None


def kernel_interface(wait, sysfs=SYSFS, dt=DT):
    """'dual' (the card has "Speaker Protection Interface": both interfaces,
    the volume lock by default), 'v2' (only "Speaker Protection"), 'legacy'
    (a speaker card with neither) or None (no speaker card within the
    wait, or controls that could not be read within it). Only the speaker
    card's controls count:
    another card that registers first (the jack-only card, HDMI) is no
    answer, so the gate waits for the speaker card itself. It waits only
    while the device tree describes one: a tree with no enabled macaudio
    node with the speaker link answers None at once."""
    start = time.monotonic()
    deadline = start + wait
    while True:
        card = speaker_card(sysfs)
        if card:
            break
        if dt_speaker_node(dt) is False:
            log("the device tree describes no speaker card (no enabled apple,macaudio node with a speaker link): not waiting for one")
            return None, None
        if time.monotonic() >= deadline:
            return None, None
        time.sleep(0.025)
    waited = time.monotonic() - start
    if waited >= 0.5:
        log(f"the speaker card {card} registered after {waited:.1f} s")
    while True:
        # A control that could not be read is asked again within the same
        # wait: only a card that opened and lacks the control is an answer.
        dual = has_control(card, INTERFACE_CONTROL)
        if dual:
            return "dual", card
        v2 = None if dual is None else has_control(card, CONTROL)
        if v2 is not None:
            return ("v2" if v2 else "legacy"), card
        if time.monotonic() >= deadline:
            return None, card
        time.sleep(0.25)


def interface(args):
    """speakerguardd.service ExecStartPre, after its ExecCondition (`v2`)
    placed this Mac on v2: on a dual kernel, put the speakers on the v2
    lease for the supervisor that starts next (every start, so a restart
    after the kernel went back to the volume lock takes it again). A no-op
    on a kernel with one interface and on a Mac the upgrade did not switch.
    Fails (the start fails; Restart= tries again) only when the kernel
    refuses the switch."""
    iface, card = kernel_interface(args.wait, dt=getattr(args, "dt", DT))
    if iface != "dual":
        return 0
    if upgrade_setting(args.setting) != "v2":
        log("not switching the speaker interface: the upgrade did not switch this Mac to v2")
        return 0
    try:
        if wiring.interface_lease(card):
            log(f"{INTERFACE_CONTROL!r} = {wiring.IF_LEASE!r} on {card}: speakerguardd v2 takes the lease next")
        else:
            log(f"{INTERFACE_CONTROL!r} is already {wiring.IF_LEASE!r} on {card}")
    except (wiring.Refused, OSError, subprocess.TimeoutExpired) as e:
        log(f"the speaker interface switch failed: {e}")
        return 1
    return 0


# What holds the speakers whenever v2 does not run: no speaker daemon, only
# the kernel's own limit.
FLOOR = "no speaker daemon runs, the kernel's own limit holds the speakers"


def decide(args):
    """(v2 runs, reason). Whenever v2 does not run, nothing does."""
    setting = upgrade_setting(getattr(args, "setting", None))
    if setting == "unreadable":
        return False, (f"cannot read the upgrade's setting {getattr(args, 'setting', None) or UPGRADE_SETTING} "
                       f"as uid {os.geteuid()} (the gate must run as root, ExecCondition=+...): {FLOOR}")
    return _decide(args)


def _decide(args):
    with open(args.gate) as f:
        gate = json.load(f)
    board = board_of(args.dt)
    if board is None:
        return False, f"no Apple device tree: not an Apple Silicon Mac; {FLOOR}"
    units = []
    why_not = None
    try:
        units = tuning_units(args.tuning_cli)
        gen.qualification_policy(board, units, gate)
        if gen.held_for_playback_rows(units, gate):
            gen.playback_policy(tuning_aid(args.tuning_cli), units, gate)
        if getattr(args, "cmd", "v2") != "prepare":
            wiring.qualification(getattr(args, "state", "/var/lib/speakerguardd"), board,
                                 os.uname().release, unit=wiring.unit_id(args.dt), units=units)
    except (wiring.Refused, OSError, ValueError, TypeError, AttributeError, subprocess.TimeoutExpired) as e:
        why_not = f"{board} is unqualified: {e}"
    iface, card = kernel_interface(args.wait, dt=getattr(args, "dt", DT))
    if iface is None and card is not None:
        return False, ((why_not or f"{board} is gated") + f"; the speaker card {card} registered, but its controls "
                       f"could not be read within {args.wait:.0f} s: {FLOOR}")
    if iface is None:
        return False, (why_not or f"{board} is gated") + f"; no speaker card: {FLOOR}"
    if why_not:
        return False, f"{why_not}: {FLOOR} ({card})"
    if iface == "legacy":
        return False, f"{board} is gated for v2, but this kernel has no \"{CONTROL}\" control on {card}: {FLOOR}"
    if iface == "dual" and upgrade_setting(getattr(args, "setting", None)) != "v2":
        return False, (f"{board} is gated for v2 and the kernel serves both interfaces on {card}, but the upgrade has not "
                       f"switched this Mac ({UPGRADE_SETTING} is not \"v2\"; aurora-speaker-upgrade run switches it): "
                       f"{FLOOR}")
    if iface == "dual":
        return True, (f"{board} ({','.join(units)}) is gated for v2, the kernel serves both interfaces on {card} and the "
                      "upgrade switched this Mac to v2: speakerguardd v2 protects the speakers")
    return True, f"{board} ({','.join(units)}) is gated for v2 and the kernel has the v2 interface on {card}: speakerguardd v2 protects the speakers"


def main():
    ap = argparse.ArgumentParser(prog="speakerguardd-gate")
    ap.add_argument("cmd", choices=["prepare", "v2", "legacy", "explain", "interface"])
    ap.add_argument("--gate", default="/usr/share/speakerguardd/gate.json")
    ap.add_argument("--dt", default=DT)
    ap.add_argument("--state", default="/var/lib/speakerguardd")
    ap.add_argument("--tuning-cli", default="aurora-speaker-tuning")
    ap.add_argument("--wait", type=float, default=15.0, help="seconds to wait for the speaker card")
    ap.add_argument("--setting", default=UPGRADE_SETTING, help="the upgrade's persistent interface choice")
    args = ap.parse_args()
    if args.cmd == "interface":
        return interface(args)
    if args.cmd == "legacy":
        log("not starting: speakerguardd v2 is the only speaker protection; the older daemons never start "
            "(this is a leftover drop-in from an older package)")
        return 1
    try:
        v2, why = decide(args)
    except (OSError, ValueError) as e:
        v2, why = False, f"cannot read the gate data: {e}; {FLOOR}"
    if args.cmd == "explain":
        print(f"v2={int(v2)}: {why}")
        return 0
    log(("starting: " if v2 else "not starting: ") + why)
    return 0 if v2 else 1


if __name__ == "__main__":
    sys.exit(main())
