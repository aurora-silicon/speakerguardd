#!/usr/bin/python3 -I
"""speakerguardd-gate: which speaker protection runs on this Mac.

    speakerguardd-gate prepare|v2      [--gate F] [--wait S]
    speakerguardd-gate legacy  [--gate F] [--wait S]
    speakerguardd-gate explain [--gate F] [--wait S]
    speakerguardd-gate interface [--gate F] [--wait S]

Every Mac carries both stacks: speakerguardd v2, and the older daemons
(speakerguardd 0.1, speakersafetyd). This program is the ExecCondition of
both, so exactly one of them runs on a board, chosen at boot:

- v2 runs (`v2` exits 0) only with current successful compilation, own-Mac
  extraction provenance, a silent wiring self-check bound to this board,
  kernel and blob, and every protection type (including LSID) at parity.
  Board policy may deny, but an allow never bypasses those proofs.
- `prepare` admits provisioning and the silent check before those records
  exist, when the graph's protection types are at parity and not denied.
- the older daemons run (`legacy` exits 0) when v2 does not and the kernel
  does not have that interface: on a v2 kernel they have nothing to own.
  An unqualified board on a v2 kernel runs neither, and the
  kernel holds its speakers at the floor.

On a kernel with only one interface the kernel is the switch: without the
v2 interface every Mac stays on the older daemons, and a v2-only kernel
moves every gated Mac to v2. A dual kernel (linux 98cb6a86 and later: the
card has "Speaker Protection Interface") serves both, with "Speaker Volume
Unlock" in charge at boot. There the Mac's own upgrade decides: v2 runs only
on a Mac aurora-speaker-upgrade switched (its root-only setting,
/var/lib/aurora-speaker-upgrade/interface), and only with every proof above;
every other Mac keeps the older daemons. On a switched Mac whose v2 is
waiting for its silent check on a new kernel neither runs (the volume
lock's ceiling holds); one the check refused goes back to the older
daemons. `interface` (the ExecStartPre of speakerguardd.service) puts a
dual kernel on the v2 lease right before the supervisor takes it; the
kernel returns to the volume lock 30 s after the last owner closes. The data (gate.json) comes from speakerguardd itself and is the same
in every distribution; everything about the hardware comes from the Mac.

Exit 0: start the unit. Exit 1: skip it (systemd logs the condition).
The reason goes to stderr, so the journal says why.
"""
import argparse
import json
import os
import re
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)
import gen  # noqa: E402
import wiring  # noqa: E402
DT = "/proc/device-tree"
# The bundle provisioning compiles when the installer's copy is not where the
# reader looks first (speakerguardd-provision: SGV2_BUNDLE=<path>).
PROVISION_CONF = "/etc/speakerguardd/provision.conf"
CONTROL = "Speaker Protection"


def log(*a):
    print("speakerguardd-gate:", *a, file=sys.stderr, flush=True)


def board_of(dt):
    try:
        with open(os.path.join(dt, "compatible"), "rb") as f:
            first = f.read().split(b"\0", 1)[0].decode()
    except (OSError, UnicodeDecodeError):
        return None
    return first[len("apple,"):] if first.startswith("apple,") and len(first) > 6 else None


def bundle_override(path):
    """SGV2_BUNDLE from provisioning's configuration, or None."""
    try:
        with open(path) as f:
            for line in f:
                line = line.strip()
                if line.startswith("SGV2_BUNDLE="):
                    v = line.split("=", 1)[1].strip()
                    if len(v) >= 2 and v[0] == v[-1] and v[0] in "\"'":
                        v = v[1:-1]
                    return v or None
    except OSError:
        pass
    return None


def tuning_units(cli, conf=None):
    """The complete protection type set from provisioning's own source."""
    bundle = bundle_override(conf or PROVISION_CONF)
    return wiring.protection_units(wiring.tuning_dump([bundle] if bundle else [], cli, strict=True))


def speaker_card(sysfs="/sys/class/sound"):
    """The speaker card's ALSA id: the card whose device tree node is a
    macaudio sound node."""
    try:
        names = sorted(os.listdir(sysfs))
    except OSError:
        return None
    for d in names:
        if not re.fullmatch(r"card\d+", d):
            continue
        try:
            with open(f"{sysfs}/{d}/device/of_node/compatible", "rb") as f:
                compat = f.read().split(b"\0")
            if b"apple,macaudio" in compat:
                with open(f"/proc/asound/{d}/id") as f:
                    return f.read().strip()
        except OSError:
            continue
    return None


def kernel_interface(wait):
    """'dual' (the card has "Speaker Protection Interface": both
    interfaces), 'v2' (only "Speaker Protection"), 'legacy' (a speaker card
    with neither) or None (no speaker card within the wait)."""
    deadline = time.monotonic() + wait
    while True:
        card = speaker_card()
        if card:
            break
        if time.monotonic() >= deadline:
            return None, None
        time.sleep(0.25)
    try:
        if wiring.interface_get(card) is not None:
            return "dual", card
        r = subprocess.run(["amixer", "-c", card, "cget", f"name={CONTROL}"], capture_output=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired, wiring.Refused) as e:
        log(f"amixer: {e}")
        return None, card
    return ("v2" if r.returncode == 0 else "legacy"), card


def check_failed(state, board):
    """True when this kernel's silent self-check ran on this board and
    failed (not merely missing or stale)."""
    try:
        b = wiring.read_binding(os.path.join(state, "selfcheck.bind"))
    except OSError:
        return False
    return b.get("result") == "fail" and b.get("board") == board and b.get("kernel") == os.uname().release


def decide(args):
    """(v2 runs, legacy runs, reason)."""
    with open(args.gate) as f:
        gate = json.load(f)
    board = board_of(args.dt)
    if board is None:
        return False, True, "no Apple device tree: not an Apple Silicon Mac"
    units = []
    why_not = None
    policy_ok = False
    state = getattr(args, "state", "/var/lib/speakerguardd")
    try:
        units = tuning_units(args.tuning_cli)
        gen.qualification_policy(board, units, gate)
        policy_ok = True
        if getattr(args, "cmd", "v2") != "prepare":
            wiring.qualification(state, board, os.uname().release, unit=wiring.unit_id(args.dt), units=units)
    except (wiring.Refused, OSError, ValueError, TypeError, AttributeError, subprocess.TimeoutExpired) as e:
        why_not = f"{board} is unqualified: {e}"
    iface, card = kernel_interface(args.wait)
    if iface is None:
        return False, True, (why_not or f"{board} is gated") + "; no speaker card: the older daemons decide for themselves"
    if iface == "dual":
        dual = f"this kernel serves both speaker interfaces on {card}"
        if not wiring.upgraded(getattr(args, "upgrade_setting", None)):
            return False, True, (f"{dual} and this Mac was not switched to speakerguardd v2 (aurora-speaker-upgrade): "
                                 "the older daemons protect the speakers")
        if not policy_ok or check_failed(state, board):
            why = why_not if not policy_ok else f"{board}: the silent self-check failed on this kernel"
            return False, True, (f"{why}; {dual}: the older daemons protect the speakers "
                                 "(aurora-speaker-upgrade run tries v2 again)")
        if why_not:
            return False, False, (f"{why_not}; {dual} and this Mac was switched to v2, which waits for its silent "
                                  "self-check: the kernel's volume lock holds the speakers at its ceiling")
        return True, False, (f"{board} ({','.join(units)}) is gated for v2, this Mac was switched to v2 "
                             f"(aurora-speaker-upgrade) and {dual}: speakerguardd v2 protects the speakers")
    if why_not:
        if iface == "v2":
            return False, False, f"{why_not}; the kernel has the v2 interface ({card}), so the older daemons have nothing to own: the kernel holds the speakers at its floor"
        return False, True, f"{why_not}; the older daemons protect the speakers"
    if iface == "legacy":
        return False, True, f"{board} is gated for v2, but this kernel has no \"{CONTROL}\" control on {card}: the older daemons protect the speakers"
    return True, False, f"{board} ({','.join(units)}) is gated for v2 and the kernel has the v2 interface on {card}: speakerguardd v2 protects the speakers"


def interface(args):
    """speakerguardd.service ExecStartPre, after its ExecCondition (`v2`)
    placed this Mac on v2: on a dual kernel, put the speakers on the v2
    lease for the supervisor that starts next (every start, so a restart
    after the kernel went back to the volume lock takes it again). A no-op
    on a kernel with one interface and on a Mac that was not switched.
    Fails (the start fails; Restart= tries again) only when the kernel
    refuses the switch."""
    iface, card = kernel_interface(args.wait)
    if iface != "dual":
        return 0
    if not wiring.upgraded(args.upgrade_setting):
        log("not switching the speaker interface: this Mac was not switched to v2 (aurora-speaker-upgrade)")
        return 0
    try:
        if wiring.interface_lease(card):
            log(f"{wiring.INTERFACE_CONTROL!r} = {wiring.IF_LEASE!r} on {card}: speakerguardd v2 takes the lease next")
        else:
            log(f"{wiring.INTERFACE_CONTROL!r} is already {wiring.IF_LEASE!r} on {card}")
    except (wiring.Refused, OSError, subprocess.TimeoutExpired) as e:
        log(f"the speaker interface switch failed: {e}")
        return 1
    return 0


def main():
    ap = argparse.ArgumentParser(prog="speakerguardd-gate")
    ap.add_argument("cmd", choices=["prepare", "v2", "legacy", "explain", "interface"])
    ap.add_argument("--upgrade-setting", default=wiring.UPGRADE_SETTING, help=argparse.SUPPRESS)
    ap.add_argument("--gate", default="/usr/share/speakerguardd/gate.json")
    ap.add_argument("--dt", default=DT)
    ap.add_argument("--state", default="/var/lib/speakerguardd")
    ap.add_argument("--tuning-cli", default="aurora-speaker-tuning")
    ap.add_argument("--wait", type=float, default=15.0, help="seconds to wait for the speaker card")
    args = ap.parse_args()
    if args.cmd == "interface":
        return interface(args)
    try:
        v2, legacy, why = decide(args)
    except (OSError, ValueError) as e:
        # Without its data the gate cannot place v2: the older daemons keep
        # the speakers, as before v2 was installed.
        iface, _ = kernel_interface(args.wait)
        v2, legacy, why = False, iface != "v2", f"cannot read the gate data: {e}"
    if args.cmd == "explain":
        print(f"v2={int(v2)} legacy={int(legacy)}: {why}")
        return 0
    run = v2 if args.cmd in ("prepare", "v2") else legacy
    log(("starting: " if run else "not starting: ") + why)
    return 0 if run else 1


if __name__ == "__main__":
    sys.exit(main())
