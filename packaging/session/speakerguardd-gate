#!/usr/bin/python3 -I
"""speakerguardd-gate: which speaker protection runs on this Mac.

    speakerguardd-gate v2      [--gate F] [--wait S]
    speakerguardd-gate legacy  [--gate F] [--wait S]
    speakerguardd-gate explain [--gate F] [--wait S]

Every Mac carries both stacks: speakerguardd v2, and the older daemons
(speakerguardd 0.1, speakersafetyd). This program is the ExecCondition of
both, so exactly one of them runs on a board, chosen at boot:

- v2 runs (`v2` exits 0) when
  1. the protection unit this Mac's own tuning names is at parity
     (gate.json units_at_parity);
  2. while gate.json require_qualified_board is true, the board is in that
     unit's qualified list (gate.json qualified: a passing audible run on
     the shipped tree), or /etc/speakerguardd/allow-unqualified names it
     (qualification itself);
  3. the kernel has the v2 interface: the speaker card has a "Speaker
     Protection" control.
- the older daemons run (`legacy` exits 0) when v2 does not and the kernel
  does not have that interface: on a v2 kernel they have nothing to own.
  A board on a v2 kernel that does not pass 1 and 2 runs neither, and the
  kernel holds its speakers at the floor.

So the kernel is the switch. A fleet kernel without the v2 interface keeps
every Mac on the older daemons; the kernel that brings the interface moves
every gated Mac to v2 at once, and booting the older kernel again moves it
back. The data (gate.json) comes from speakerguardd itself and is the same
in every distribution; everything about the hardware comes from the Mac.

Exit 0: start the unit. Exit 1: skip it (systemd logs the condition).
The reason goes to stderr, so the journal says why.
"""
import argparse
import json
import os
import re
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.realpath(__file__))
DT = "/proc/device-tree"
ALLOW = "/etc/speakerguardd/allow-unqualified"
# The bundle provisioning compiles when the installer's copy is not where the
# reader looks first (speakerguardd-provision: SGV2_BUNDLE=<path>).
PROVISION_CONF = "/etc/speakerguardd/provision.conf"
CONTROL = "Speaker Protection"


def log(*a):
    print("speakerguardd-gate:", *a, file=sys.stderr, flush=True)


def board_of(dt):
    try:
        with open(os.path.join(dt, "compatible"), "rb") as f:
            first = f.read().split(b"\0", 1)[0].decode()
    except (OSError, UnicodeDecodeError):
        return None
    return first[len("apple,"):] if first.startswith("apple,") and len(first) > 6 else None


def bundle_override(path):
    """SGV2_BUNDLE from provisioning's configuration, or None."""
    try:
        with open(path) as f:
            for line in f:
                line = line.strip()
                if line.startswith("SGV2_BUNDLE="):
                    v = line.split("=", 1)[1].strip()
                    if len(v) >= 2 and v[0] == v[-1] and v[0] in "\"'":
                        v = v[1:-1]
                    return v or None
    except OSError:
        pass
    return None


def tuning_unit(cli, conf=None):
    """The protection unit this Mac's own tuning names, or None: the bundle
    provisioning compiles (its SGV2_BUNDLE, else the installer's copy)."""
    bundle = bundle_override(conf or PROVISION_CONF)
    try:
        r = subprocess.run([cli, "dump", "--json"] + ([bundle] if bundle else []), capture_output=True, text=True,
                           timeout=30)
        return json.loads(r.stdout)["tuning"]["protection"]["kind"]
    except (OSError, ValueError, KeyError, TypeError, subprocess.TimeoutExpired):
        return None


def speaker_card(sysfs="/sys/class/sound"):
    """The speaker card's ALSA id: the card whose device tree node is a
    macaudio sound node."""
    try:
        names = sorted(os.listdir(sysfs))
    except OSError:
        return None
    for d in names:
        if not re.fullmatch(r"card\d+", d):
            continue
        try:
            with open(f"{sysfs}/{d}/device/of_node/compatible", "rb") as f:
                compat = f.read().split(b"\0")
            if b"apple,macaudio" in compat:
                with open(f"/proc/asound/{d}/id") as f:
                    return f.read().strip()
        except OSError:
            continue
    return None


def kernel_interface(wait):
    """'v2' (the card has "Speaker Protection"), 'legacy' (a speaker card
    without it) or None (no speaker card within the wait)."""
    deadline = time.monotonic() + wait
    while True:
        card = speaker_card()
        if card:
            break
        if time.monotonic() >= deadline:
            return None, None
        time.sleep(0.25)
    try:
        r = subprocess.run(["amixer", "-c", card, "cget", f"name={CONTROL}"], capture_output=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired) as e:
        log(f"amixer: {e}")
        return None, card
    return ("v2" if r.returncode == 0 else "legacy"), card


def decide(args):
    """(v2 runs, legacy runs, reason)."""
    with open(args.gate) as f:
        gate = json.load(f)
    board = board_of(args.dt)
    if board is None:
        return False, True, "no Apple device tree: not an Apple Silicon Mac"
    unit = tuning_unit(args.tuning_cli)
    parity = gate.get("units_at_parity", [])
    why_not = None
    if unit is None:
        why_not = f"{board}'s tuning names no protection unit (no tuning bundle, or one the reader refuses)"
    elif unit not in parity:
        why_not = f"{board}'s protection unit {unit} is not at parity yet (at parity: {' '.join(parity) or 'none'})"
    elif gate.get("require_qualified_board", True) and board not in (gate.get("qualified") or {}).get(unit, []):
        allowed = False
        try:
            with open(ALLOW) as f:
                allowed = board in f.read().split()
        except OSError:
            pass
        if not allowed:
            why_not = f"{board} has not qualified on speakerguardd v2 (no passing audible run on the shipped tree)"
        else:
            log(f"{board} has not qualified; {ALLOW} names it, so v2 may start")
    iface, card = kernel_interface(args.wait)
    if iface is None:
        return False, True, (why_not or f"{board} is gated") + "; no speaker card: the older daemons decide for themselves"
    if why_not:
        if iface == "v2":
            return False, False, f"{why_not}; the kernel has the v2 interface ({card}), so the older daemons have nothing to own: the kernel holds the speakers at its floor"
        return False, True, f"{why_not}; the older daemons protect the speakers"
    if iface == "legacy":
        return False, True, f"{board} is gated for v2, but this kernel has no \"{CONTROL}\" control on {card}: the older daemons protect the speakers"
    return True, False, f"{board} ({unit}) is gated for v2 and the kernel has the v2 interface on {card}: speakerguardd v2 protects the speakers"


def main():
    ap = argparse.ArgumentParser(prog="speakerguardd-gate")
    ap.add_argument("cmd", choices=["v2", "legacy", "explain"])
    ap.add_argument("--gate", default="/usr/share/speakerguardd/gate.json")
    ap.add_argument("--dt", default=DT)
    ap.add_argument("--tuning-cli", default="aurora-speaker-tuning")
    ap.add_argument("--wait", type=float, default=15.0, help="seconds to wait for the speaker card")
    args = ap.parse_args()
    try:
        v2, legacy, why = decide(args)
    except (OSError, ValueError) as e:
        # Without its data the gate cannot place v2: the older daemons keep
        # the speakers, as before v2 was installed.
        v2, legacy, why = False, True, f"cannot read the gate data: {e}"
    if args.cmd == "explain":
        print(f"v2={int(v2)} legacy={int(legacy)}: {why}")
        return 0
    run = v2 if args.cmd == "v2" else legacy
    log(("starting: " if run else "not starting: ") + why)
    return 0 if run else 1


if __name__ == "__main__":
    sys.exit(main())
