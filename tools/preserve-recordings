#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Preserve stopped recording segments within a bounded archive budget."""
import os
from pathlib import Path
import re
import stat
import sys
import tempfile

DEFAULT_BUDGET = 4 * 1024 ** 3


def fail(message):
    print(f"recording preservation failed: {message}; protection must start without overwriting evidence", file=sys.stderr)
    return 1


def bytes_in(directory):
    allowed = {directory.name.split('.saved.')[0] + suffix for suffix in ('', '.previous', '.next')}
    total = 0
    for p in directory.iterdir():
        if p.name not in allowed | {'.incomplete'} or not stat.S_ISREG(p.lstat().st_mode):
            raise OSError(f"unrecognized archive content: {p}")
        total += p.stat().st_size
    return total


def remove_archive(directory):
    """Leave a marker if deleting an old archive stops partway through."""
    marker = directory / '.incomplete'
    marker.touch(exist_ok=False)
    for p in directory.iterdir():
        if p != marker:
            p.unlink()
    marker.unlink()
    directory.rmdir()


def archives_for(path):
    archives = []
    for candidate in path.parent.glob(path.name + '.saved.*'):
        if not re.fullmatch(re.escape(path.name) + r"\.saved\.[A-Za-z0-9_]{8,10}", candidate.name):
            continue
        if candidate.is_symlink() or not candidate.is_dir():
            continue
        size = bytes_in(candidate)
        incomplete = (candidate / '.incomplete').exists()
        archives.append((candidate.stat().st_mtime_ns, candidate.name, candidate, size, incomplete))
    archives.sort()
    return archives


def main():
    if len(sys.argv) != 2 or not Path(sys.argv[1]).is_absolute():
        return fail("usage: preserve-recordings /absolute/recording-path")
    path = Path(sys.argv[1])
    try:
        budget = int(os.environ.get("SG_RECORD_ARCHIVE_MAX_BYTES", DEFAULT_BUDGET))
        if budget <= 0:
            return fail("archive budget must be positive")
        lock = Path(str(path) + ".preserve-lock")
        lock.mkdir(mode=0o700)
    except (OSError, ValueError) as e:
        return fail(str(e))
    try:
        sources = [Path(str(path) + suffix) for suffix in ("", ".previous", ".next")]
        present = []
        for source in sources:
            try:
                mode = source.lstat().st_mode
            except FileNotFoundError:
                continue
            if not stat.S_ISREG(mode):
                return fail(f"refusing non-regular recording: {source}")
            present.append(source)
        incoming = sum(p.stat().st_size for p in present)
        if incoming > budget:
            return fail("current evidence exceeds archive budget; retained in place")
        archives = archives_for(path)
        total = sum(item[3] for item in archives)
        for _, _, old, size, incomplete in archives:
            if total + incoming <= budget:
                break
            if incomplete:
                continue
            remove_archive(old)
            total -= size
            print(f"recording archive budget: removed oldest {old}", file=sys.stderr)
        if total + incoming > budget:
            return fail("incomplete evidence leaves insufficient archive budget; retained in place")
        if not present:
            print("recording preservation: no prior recording segments", file=sys.stderr)
        else:
            saved = Path(tempfile.mkdtemp(prefix=path.name + ".saved.", dir=path.parent))
            marker = saved / ".incomplete"
            marker.touch(exist_ok=False)
            for source in present:
                os.replace(source, saved / source.name)
                print(f"recording evidence kept: {saved / source.name}", file=sys.stderr)
            marker.unlink()
        return 0
    except OSError as e:
        return fail(str(e))
    finally:
        try:
            lock.rmdir()
        except OSError as e:
            print(f"recording preservation lock cleanup failed: {e}", file=sys.stderr)


if __name__ == "__main__":
    sys.exit(main())
